; The SID to a Bluetooth speaker: PureMetal's Shared/Bluetooth/bt_audio.pmi
; (A2DP + SBC, 48 kHz) reads the SID's sample ring itself (BtAudioSource).
; Core 0 connects (AudioBegin); core 1 drives the radio (AudioPoll).
;
; The speaker's address comes from a PRIVATE wrapper (never in git) that calls
; C64BluetoothSetPeer(?address) before C64Main(). Without one there is no sound
; and nothing else changes. The link key the speaker paired with is kept in
; the flash's last sector behind "BTK1" (the same record the NES and the tone
; example use for the same speaker), so it pairs once.
#BT_KEY_FLASH = $1FF000
#BT_LEAD_US = 65000
Global Dim C64BtPeer.a(6)
Global Dim C64KeyBuf.a(256)
Global C64BtPeerSet.i, AudioRunning.i, AudioLive.i, AudioUnderruns.i, AudioPackets.i
Global AudioLastPoll.i, AudioGap.i = 700, AudioBusyUs.i, AudioLastRead.i
Global Core1ParkRequest.i, Core1Parked.i

; Six bytes in HCI order (least significant first), as the NES's wrapper keeps them.
Procedure C64BluetoothSetPeer(src.i)
  Protected i.i
  For i = 0 To 5 : C64BtPeer(i) = PeekA(src + 5 - i) : Next
  BtAudioStereo(1) : C64BtPeerSet = 1
EndProcedure

Procedure.i C64BtKeyAddr()
  Protected k.i
  k = $10000000 + #BT_KEY_FLASH
  If PeekA(k) = 66 And PeekA(k + 1) = 84 And PeekA(k + 2) = 75 And PeekA(k + 3) = 49 : ProcedureReturn k + 4 : EndIf
  ProcedureReturn 0
EndProcedure

Procedure.i C64SaveBtKey()
  Protected i.i, start.i, ok.i
  For i = 0 To 255 : C64KeyBuf(i) = 255 : Next
  C64KeyBuf(0) = 66 : C64KeyBuf(1) = 84 : C64KeyBuf(2) = 75 : C64KeyBuf(3) = 49
  If BtAudioKey(@C64KeyBuf(4)) = 0 : ProcedureReturn 0 : EndIf
  Core1ParkRequest = 1 : start = Micros()
  While PeekL(@Core1Parked) = 0
    UsbSerialTask() : SafetyPet()
    If Micros() - start > 1000000 : Core1ParkRequest = 0 : ProcedureReturn 0 : EndIf
  Wend
  ok = FlashRangeErase(#BT_KEY_FLASH, 4096)
  If ok : ok = FlashRangeProgram(#BT_KEY_FLASH, @C64KeyBuf(0), 256) : EndIf
  Core1ParkRequest = 0
  ProcedureReturn ok
EndProcedure

Procedure AudioBegin()
  Protected rc.i, key.i
  AudioRunning = 0 : AudioLive = 0
  If C64BtPeerSet = 0
    Say("C64 audio: no speaker address (public build) - silent") : Eol()
    ProcedureReturn
  EndIf
  Say("C64 Bluetooth: connecting the speaker") : Eol()
  key = C64BtKeyAddr()
  If key : BtAudioSetKey(key) : EndIf
  rc = BtAudioBegin(@C64BtPeer(0))
  Say("BT AUDIO rc=") : Num(rc) : Eol()
  If rc <> 0
    Say("C64 Bluetooth unavailable (HCI status ") : Num(BtAudioStatus()) : Say("); continuing without sound") : Eol()
    ProcedureReturn
  EndIf
  If BtAudioKeyNew()
    If C64SaveBtKey() : Say("C64 Bluetooth: link key saved") : Else : Say("C64 Bluetooth: link key NOT saved") : EndIf
    Eol()
  EndIf
  BtAudioSource(@SidPcm(0), #SID_RING, @SidSamples)
  BtAudioLead(#BT_LEAD_US)
  BtAudioPumps(0)
  AudioLive = 1 : AudioRunning = 1
EndProcedure

ProcedureRAM AudioPoll()
  Protected start.i
  If AudioRunning = 0 : ProcedureReturn : EndIf
  start = Micros()
  If start - AudioLastPoll < AudioGap : ProcedureReturn : EndIf
  AudioLastPoll = start
  BtAudioPoll()
  If BtAudioBusy() : AudioGap = 150 : Else : AudioGap = 700 : EndIf
  If start - AudioLastRead > 100000
    AudioLive = BtAudioLive() : AudioUnderruns = BtAudioUnderruns() : AudioPackets = BtAudioPackets()
    AudioLastRead = start
  EndIf
  AudioBusyUs = AudioBusyUs + Micros() - start
EndProcedure
