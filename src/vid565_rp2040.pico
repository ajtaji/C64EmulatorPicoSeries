; Core 1: one 384-pixel line of colour indices to RGB565, four pixels a word read through PalPair
; (pico_video.pmi) - Thumb-1. Only r0-r3, r6 and r12 are free here: r4, r5 and r8-r11 hold the 6510's
; globals for the whole program (ReserveRegister), and core 1 may not name them (PM1125). So each word
; is read twice (once a pixel pair) instead of being held, and r12 holds the end of the line.
Global VidCvSrc.i, VidCvDst.i
ProcedureRAM VidLine565(from.i, into.i)
  VidCvSrc = from : VidCvDst = into
  ASM
    ldr r0, =global_vidcvsrc
    ldr r0, [r0]
    ldr r1, =global_vidcvdst
    ldr r1, [r1]
    ldr r2, =global_palpair
    movs r3, #192
    lsls r3, r3, #1
    adds r3, r3, r0
    mov r12, r3
  vl565_loop:
    ldmia r0!, {r6}
    lsls r3, r6, #28
    lsrs r3, r3, #26
    lsrs r6, r6, #8
    lsls r6, r6, #28
    lsrs r6, r6, #22
    orrs r3, r6
    ldr r3, [r2, r3]
    stmia r1!, {r3}
    subs r0, #4
    ldmia r0!, {r6}
    lsls r3, r6, #12
    lsrs r3, r3, #26
    lsrs r6, r6, #24
    lsls r6, r6, #28
    lsrs r6, r6, #22
    orrs r3, r6
    ldr r3, [r2, r3]
    stmia r1!, {r3}
    cmp r0, r12
    bne vl565_loop
  EndASM
EndProcedure
