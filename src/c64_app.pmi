; The C64 on a Pico: core 0 runs the machine a frame at a time, paced to the
; real 50.12 Hz (PAL) or 59.83 Hz (NTSC); core 1 drives the panel and the radio.
;
; At power-on: with BASIC, KERNAL and CHARGEN in the flash store it boots the
; real machine (and the store's first .D64 is in drive 8); without them it runs
; the built-in demo, a program of this project's own (no ROM needed).
;
; USB serial in (115200, any terminal):
;   ordinary characters are typed on the C64's keyboard (into its buffer)
;   `s  the screen's text      `r  reset      `d  the built-in demo
;   `b  boot BASIC             `m  mute       `0-`9 put the store's n-th .PRG in and RUN it
;   `l  LOAD"*",8,1 and RUN    `j  joystick fire for 0.2 s      `u/`n/`a/`e  up/down/left/right 0.2 s
;   `p  the time split (CPU / VIC / SID per second) in the status line, on / off
; Out: C64_STATUS once a second (frames, emulation time, display, audio).
XIncludeFile "cpu6510.pmi"
XIncludeFile "c64.pmi"
XIncludeFile "cia.pmi"
XIncludeFile "vic.pmi"
XIncludeFile "sid.pmi"
XIncludeFile "bench.pmi"
XIncludeFile "loader.pmi"
XIncludeFile "pico_video.pmi"
CompilerIf #C64_AUDIO = 1
  XIncludeFile "pico_audio.pmi"
CompilerElse
  XIncludeFile "pico_audio_null.pmi"
CompilerEndIf
XIncludeFile "pico_input.pmi"
XIncludeFile "pico_store.pmi"
XIncludeFile "demo_data.pmi"

Global AppMode.i, AppBacktick.i, AppFrameUs.i, AppNext.i, AppEmuUs.i, AppWorstUs.i, AppLate.i
Global AppLastTick.i, Core1Ready.i, AppFrames.i

Procedure.i BenchFile(nameAdr.i, n.i)
  ProcedureReturn 0
EndProcedure
Procedure BenchPrint(c.i)
EndProcedure
Procedure BenchEvent(kind.i, rec.i)
EndProcedure
Procedure PlatformFrameDone()
EndProcedure
ProcedureRAM.i PlatformUs()
  ProcedureReturn Micros()
EndProcedure

ProcedureRAM Core1Main()
  Core1Ready = 1
  Repeat
    If PeekL(@Core1ParkRequest)
      VidFence() : Core1Parked = 1
      While PeekL(@Core1ParkRequest) : Wend
      Core1Parked = 0
    EndIf
    VideoPoll()
    AudioPoll()
  ForEver
EndProcedure

Procedure AppScreen()
  Protected r.i, c.i, ch.i, base.i
  base = ((VicReg($18) & $F0) << 6) + (3 - ((CiaPra(1) | (~CiaDdra(1))) & 3)) * $4000
  Say("SCREEN_BEGIN") : Eol()
  For r = 0 To 24
    For c = 0 To 39
      ch = M((base + r * 40 + c) & $FFFF) & 127
      If ch < 32 : ch = ch + 64 : ElseIf ch >= 64 And ch < 96 : ch = ch + 32 : EndIf
      If ch < 32 Or ch > 126 : ch = 46 : EndIf
      UsbSerialWrite(ch)
    Next
    Eol()
  Next
  Say("SCREEN_END") : Eol()
EndProcedure

Procedure AppDemo()
  AppMode = 1
  BenchRoms() : BenchMode = 0
  C64PowerOn()
  C64InjectPrg(?DemoPrg, #DEMO_SIZE, 0)
  PC = #DEMO_START
  Say("C64 mode=demo (the built-in demo)") : Eol()
EndProcedure

Procedure.i AppBoot()
  Protected b.i, k.i, c.i
  If StoreFind(1, 0) = 0 : ProcedureReturn 0 : EndIf
  b = StoreAddr
  If StoreFind(2, 0) = 0 : ProcedureReturn 0 : EndIf
  k = StoreAddr
  If StoreFind(3, 0) = 0 : ProcedureReturn 0 : EndIf
  c = StoreAddr
  AppMode = 2
  BenchMode = 0
  C64SetRoms(b, k, c)
  C64PowerOn()
  C64Frame = 0
  C64InsertD64(0, 0)
  If StoreFind(5, 0) : C64InsertD64(StoreAddr, StoreSize) : EndIf
  Say("C64 mode=basic load_trap=") : Num(LoadTrapOn) : Say(" d64=") : Num(D64Inserted) : Eol()
  ProcedureReturn 1
EndProcedure

Procedure AppCommand(key.i)
  If key = 115 : AppScreen()
  ElseIf key = 114
    If AppMode = 2 : AppBoot() : Else : AppDemo() : EndIf
  ElseIf key = 100 : AppDemo()
  ElseIf key = 98
    If AppBoot() = 0 : Say("C64 no ROMs in the store") : Eol() : EndIf
  ElseIf key = 109 : SidMute = 1 - SidMute
  ElseIf key = 112 : PerfOn = 1 - PerfOn
  ElseIf key >= 48 And key <= 57
    If StoreFind(4, key - 48)
      C64QueuePrg(StoreAddr, StoreSize, 1)
      Say("C64 prg queued size=") : Num(StoreSize) : Eol()
    Else
      Say("C64 no PRG ") : Num(key - 48) : Eol()
    EndIf
  ElseIf key = 108 : C64TypeText(?TextLoadRun)
  ElseIf key = 106 : InHostJoy = $10 : InHostJoyUntil = Micros() + 200000
  ElseIf key = 117 : InHostJoy = 1 : InHostJoyUntil = Micros() + 200000
  ElseIf key = 110 : InHostJoy = 2 : InHostJoyUntil = Micros() + 200000
  ElseIf key = 97 : InHostJoy = 4 : InHostJoyUntil = Micros() + 200000
  ElseIf key = 101 : InHostJoy = 8 : InHostJoyUntil = Micros() + 200000
  EndIf
EndProcedure

; Every 16 raster lines: USB, the watchdog and the controls.
Procedure PlatformTick()
  Protected key.i
  UsbSerialTask() : SafetyPet()
  InputPoll()
  key = UsbSerialRead()
  If key >= 0
    If AppBacktick
      AppBacktick = 0 : AppCommand(key)
    ElseIf key = 96
      AppBacktick = 1
    ElseIf key = 13 Or key = 10
      If key = 13 : C64Type(13) : EndIf
    Else
      C64Type(key)
    EndIf
  EndIf
EndProcedure

Procedure C64Main()
  Protected t.i, report.i, frames.i, now.i, lastMade.i, lastOut.i, lastSamples.i, lastVf.i, lastIns.i
  BoardBegin()
  Say("C64 PureMetal clk_khz=") : Num(ClockSysKhz()) : Eol()
  VideoBegin()
  InputBegin()
  Say("C64 core1 launch=") : Num(PlatformLaunchCore1()) : Eol()
  t = Micros()
  While PeekL(@Core1Ready) = 0 And Micros() - t < 1000000 : SafetyPet() : Wend
  AudioBegin()
  ; the Pico W synthesises the SID at 24 kHz (each sample written twice to the 48 kHz ring)
  CompilerIf #PM_SRAM_BYTES < 300000
    SidDiv = 2
  CompilerEndIf
  C64SetStandard(1)
  If AppBoot() = 0 : AppDemo() : EndIf
  If C64Pal : AppFrameUs = 19950 : Else : AppFrameUs = 16715 : EndIf
  Say("C64 spi_hz=") : Num(SpiHz(0)) : Say(" frame_us=") : Num(AppFrameUs) : Eol()
  AppNext = Micros() : report = AppNext
  Repeat
    C64LoaderFrame()
    t = Micros()
    C64RunFrame()
    now = Micros()
    AppEmuUs = AppEmuUs + now - t
    If now - t > AppWorstUs : AppWorstUs = now - t : EndIf
    AppFrames = AppFrames + 1 : frames = frames + 1
    AppNext = AppNext + AppFrameUs
    If now - AppNext > 100000
      AppNext = now : AppLate = AppLate + 1
    EndIf
    While Micros() - AppNext < 0
      PlatformTick()
    Wend
    now = Micros()
    If now - report >= 1000000
      Say("C64_STATUS frames=") : Num(frames) : Say(" us=") : Num(now - report)
      Say(" emu_us=") : Num(AppEmuUs) : Say(" worst_us=") : Num(AppWorstUs)
      Say(" kips=") : Num((CpuInstructions - lastIns) / 1000)
      Say(" lines_made=") : Num(LinesMade - lastMade) : Say(" lines_out=") : Num(VidLinesOut - lastOut)
      Say(" lcd_frames=") : Num(VidFrames - lastVf) : Say(" vid_wait_us=") : Num(VidWaitUs)
      Say(" sid=") : Num(SidSamples - lastSamples)
      Say(" bt_live=") : Num(AudioLive) : Say(" bt_under=") : Num(AudioUnderruns) : Say(" bt_packets=") : Num(AudioPackets)
      Say(" pc=$") : Hex4(PC) : Say(" stop=") : Num(Stopped) : Say(" late=") : Num(AppLate)
      Say(" loads=") : Num(LoadCount)
      If PerfOn : Say(" cpu_us=") : Num(PerfCpuUs) : Say(" vic_us=") : Num(PerfVicUs) : Say(" sid_us=") : Num(PerfSidUs) : EndIf
      Eol()
      PerfCpuUs = 0 : PerfVicUs = 0 : PerfSidUs = 0
      lastMade = LinesMade : lastOut = VidLinesOut : lastSamples = SidSamples : lastVf = VidFrames
      lastIns = CpuInstructions
      frames = 0 : AppEmuUs = 0 : AppWorstUs = 0 : VidWaitUs = 0 : report = now
    EndIf
  ForEver
EndProcedure

DataSection
TextLoadRun:
  Data.a 76, 79, 65, 68, 34, 42, 34, 44, 56, 44, 49, 13, 82, 85, 78, 13, 0
EndDataSection
