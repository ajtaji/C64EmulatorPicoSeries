; The C64's picture on the LAFVIN ST7796 (480 x 320, landscape), 1:1.
;
; Core 0's VIC writes each line as 384 colour indices into a ring of 32 lines
; (PlatformLine / PlatformLineDone). Core 1 turns them into RGB565, four lines
; to a buffer, two buffers, and sends them with SPI0's DMA while it converts
; the next. It converts two pixels a table read (PalPair: two colours -> two
; RGB565 halfwords in one word): a pixel at a time took about half of core 1,
; and with the radio's SBC encoding on the same core it fell behind (45
; frames/s, the speaker starved). A frame opens the panel's window at its first line, so a dropped
; or late line can never shift the picture: the window is re-opened at the
; line that comes next whenever the sequence breaks.
;
; LAFVIN wiring: SCK GP2, MOSI GP3 (SPI0, 100 MHz from clk_sys 200 MHz),
; CS GP5, DC GP6, RST GP7.
#VID_X0 = 48
#VID_Y0 = 24
#VID_W = 384
#VID_H = 272
#VID_RING = 32
#VID_BATCH = 4
; whole words, so every line starts word-aligned (the VIC writes it 32 bits at a time)
Global Dim LineRing.l(#VID_RING * #VID_W / 4)
Global Dim LineTag.i(#VID_RING)
Global Dim Pal565.u(32)
Global Dim PalPair.l(256)
; words, so the converter stores two pixels at a time on an aligned address
Global Dim DmaBuf.l(#VID_BATCH * #VID_W)
Global LinesMade.i, LinesSent.i, VidWaitUs.i, VidDropped.i
Global VidOpen.i, VidNextRow.i, VidBusy.i, VidCur.i, VidPending.i, VidPendingLines.i
Global VidFrames.i, VidLinesOut.i, VidSkip.i

ProcedureRAM VidFence()
  ASM
    dmb
  EndASM
EndProcedure

Procedure VideoBegin()
  Protected i.i, r.i, g.i, b.i
  For i = 0 To 15
    r = PeekA(?C64Palette + i * 3) : g = PeekA(?C64Palette + i * 3 + 1) : b = PeekA(?C64Palette + i * 3 + 2)
    Pal565(i) = ((r >> 3) << 11) | ((g >> 2) << 5) | (b >> 3)
    Pal565(i + 16) = Pal565(i)
  Next
  ; PalPair(a | b << 4): pixel a then pixel b (the lower address first)
  For i = 0 To 255 : PalPair(i) = Pal565(i & 15) | (Pal565(i >> 4) << 16) : Next
  SpiPeriFromSys(#CLOCK_KHZ)
  SpiBegin(0, 2, 3, -1, 100000)
  Tft796Begin(0, 5, 6, 7) : Tft796Rotate(1) : Tft796Fill(0)
EndProcedure

; Core 0: the buffer for view line viewY, once core 1 has room for it.
ProcedureRAM.i PlatformLine(viewY.i)
  Protected start.i, slot.i
  If LinesMade - PeekL(@LinesSent) >= #VID_RING
    start = Micros()
    While LinesMade - PeekL(@LinesSent) >= #VID_RING
      If Micros() - start > 200000 : Break : EndIf
    Wend
    VidWaitUs = VidWaitUs + Micros() - start
  EndIf
  slot = LinesMade & (#VID_RING - 1)
  LineTag(slot) = viewY
  ProcedureReturn @LineRing(0) + slot * #VID_W
EndProcedure
ProcedureRAM PlatformLineDone(viewY.i)
  VidFence()
  LinesMade = LinesMade + 1
EndProcedure

; Core 1 side ------------------------------------------------------------
ProcedureRAM VidDmaStart(pointer.i, halfwords.i)
  PokeL(#SPI_DMA_CH0_READ, pointer)
  PokeL(#SPI_DMA_CH0_WRITE, $4003C008)
  PokeL(#SPI_DMA_CH0_COUNT, halfwords)
  PokeL(#SPI_DMA_CH0_CTRL, #SPI_DMA_EN | #SPI_DMA_SIZE_HALF | #SPI_DMA_INCR_READ | (#SPI_DMA_TREQ_SPI0_TX << 15))
EndProcedure
ProcedureRAM.i VidDmaIdle()
  If PeekL(#SPI_DMA_CH0_CTRL) & #SPI_DMA_BUSY : ProcedureReturn 0 : EndIf
  If PeekL($4003C00C) & #SPI_SR_BSY : ProcedureReturn 0 : EndIf
  ProcedureReturn 1
EndProcedure
Procedure VidClose()
  If VidOpen
    SpiDmaRestore(0) : Tft796PinSet(tft796_cs, 1)
    VidOpen = 0
  EndIf
EndProcedure
; Open the panel's window at C64 view row `row` down to the bottom.
Procedure VidOpenAt(row.i)
  VidClose()
  Tft796Window(#VID_X0, #VID_Y0 + row, #VID_X0 + #VID_W - 1, #VID_Y0 + #VID_H - 1)
  SpiDmaInit() : SpiSetBits(0, 16)
  Tft796PinSet(tft796_dc, 1) : Tft796PinSet(tft796_cs, 0)
  PokeL($4003C024, PeekL($4003C024) | #SPI_SSPDMACR_TXDMAE)
  VidOpen = 1 : VidNextRow = row
EndProcedure

; Convert up to #VID_BATCH consecutive lines into buffer VidCur.
ProcedureRAM.i VidConvert()
  Protected n.i, slot.i, src.i, dst.i, i.i, tag.i, w.i
  dst = @DmaBuf(VidCur * #VID_BATCH * #VID_W / 2)
  n = 0
  While n < #VID_BATCH And LinesSent <> PeekL(@LinesMade)
    slot = LinesSent & (#VID_RING - 1)
    tag = LineTag(slot)
    If tag <> VidNextRow + n : Break : EndIf
    VidFence()
    src = @LineRing(0) + slot * #VID_W
    ; four pixels a word read (bit 4, the foreground flag, is dropped by the masks)
    For i = 0 To #VID_W / 4 - 1
      w = PeekL(src)
      PokeL(dst, PalPair((w & 15) | ((w >> 4) & $F0)))
      PokeL(dst + 4, PalPair(((w >> 16) & 15) | ((w >> 20) & $F0)))
      src = src + 4 : dst = dst + 8
    Next
    VidFence()
    LinesSent = LinesSent + 1
    n = n + 1
  Wend
  ProcedureReturn n
EndProcedure

ProcedureRAM VideoPoll()
  Protected slot.i, tag.i
  If VidBusy
    If VidDmaIdle() = 0
      ; while the panel takes one buffer, fill the other
      If VidPending = 0 And LinesSent <> PeekL(@LinesMade)
        VidPendingLines = VidConvert()
        If VidPendingLines : VidPending = 1 : EndIf
      EndIf
      ProcedureReturn
    EndIf
    VidBusy = 0
  EndIf
  If VidPending
    VidDmaStart(@DmaBuf(VidCur * #VID_BATCH * #VID_W / 2), VidPendingLines * #VID_W)
    VidNextRow = VidNextRow + VidPendingLines
    VidLinesOut = VidLinesOut + VidPendingLines
    VidCur = 1 - VidCur : VidBusy = 1 : VidPending = 0
    ProcedureReturn
  EndIf
  If LinesSent = PeekL(@LinesMade) : ProcedureReturn : EndIf
  slot = LinesSent & (#VID_RING - 1)
  tag = LineTag(slot)
  If VidOpen = 0 Or tag <> VidNextRow
    ; a new frame (row 0), or the sequence broke: re-open the window there
    If tag = 0 : VidFrames = VidFrames + 1 : EndIf
    VidOpenAt(tag)
  EndIf
  VidPendingLines = VidConvert()
  If VidPendingLines : VidPending = 1 : EndIf
EndProcedure

DataSection
C64Palette:
  ; the VIC-II's 16 colours (Pepto's PAL measurements)
  Data.a $00,$00,$00, $FF,$FF,$FF, $68,$37,$2B, $70,$A4,$B2, $6F,$3D,$86, $58,$8D,$43, $35,$28,$79, $B8,$C7,$6F
  Data.a $6F,$4F,$25, $43,$39,$00, $9A,$67,$59, $44,$44,$44, $6C,$6C,$6C, $9A,$D2,$84, $6C,$5E,$B5, $95,$95,$95
EndDataSection
