; Lorenz's test suite on the WHOLE machine: the CIA, interrupt, timing and
; banking tests that follow trap17 need real CIAs, a VIC and the PLA, so they
; run here with stand-in ROMs that hold only what Christer Palm's test bench
; gives a test: the KERNAL's IRQ entry at $FF48, the vectors, BASIC's warm start
; vector at $A002 -> $8000, and $02 traps at $FFD2 (print), $E16F (load the
; next test), $FFE4 (a failed test waits for a key), $8000 / $A474 (finished).
;
; The platform supplies BenchFile(name, length): the address of a record
;   name length, name, size lo, size hi, the .PRG bytes
; for the named test, or 0 when it has none (which ends the run: the batch
; prints the name so the next one can start there).
Declare.i BenchFile(nameAdr.i, n.i)
Declare BenchPrint(c.i)
Declare BenchEvent(kind.i, rec.i)
Global BenchMode.i, BenchFailures.i, BenchTests.i, BenchFinished.i, BenchCurrent.i, BenchStopName.i
Global Dim BenchName.a(32)
Global BenchNameLen.i

Procedure BenchRoms()
  Protected i.i
  For i = 0 To 8191 : RomKernal(i) = 0 : RomBasic(i) = 0 : Next
  For i = 0 To 4095 : RomChar(i) = 0 : Next
  For i = 0 To 18 : RomKernal($FF48 - $E000 + i) = PeekA(?BenchIrq + i) : Next
  RomKernal($FFFE - $E000) = $48 : RomKernal($FFFF - $E000) = $FF
  RomKernal($FFFA - $E000) = $43 : RomKernal($FFFB - $E000) = $FE
  RomKernal($FE43 - $E000) = $02
  RomKernal($FFFC - $E000) = $00 : RomKernal($FFFD - $E000) = $80
  RomKernal($FFD2 - $E000) = $02 : RomKernal($E16F - $E000) = $02 : RomKernal($FFE4 - $E000) = $02
  RomBasic($A002 - $A000) = $00 : RomBasic($A003 - $A000) = $80
  RomBasic($A474 - $A000) = $02
  C64RomsLoaded = 1
EndProcedure

Procedure BenchLoad(rec.i)
  Protected n.i, size.i, dat.i, adr.i, i.i
  n = PeekA(rec)
  size = PeekA(rec + 1 + n) | (PeekA(rec + 2 + n) << 8)
  dat = rec + 3 + n
  adr = PeekA(dat) | (PeekA(dat + 1) << 8)
  For i = 2 To size - 1
    M((adr + i - 2) & $FFFF) = PeekA(dat + i)
  Next
  M($0002) = $00 : M($01FE) = $FF : M($01FF) = $7F
  ; in RAM too, for the tests that bank the ROMs out
  M($A002) = $00 : M($A003) = $80 : M($FFFE) = $48 : M($FFFF) = $FF
  For i = 0 To 18 : M($FF48 + i) = PeekA(?BenchIrq + i) : Next
  M($FFD2) = $02 : M($E16F) = $02 : M($FFE4) = $02 : M($8000) = $02 : M($A474) = $02
  BenchTests = BenchTests + 1 : BenchCurrent = rec
  BenchEvent(1, rec)
EndProcedure

Procedure BenchRts()
  CpuPop(Lo) : CpuPop(Hi)
  PC = ((Lo | (Hi << 8)) + 1) & $FFFF
EndProcedure

Procedure.i BenchTrap(addr.i)
  Protected i.i, c.i, n.i, rec.i
  If addr = $FFD2
    M($030C) = 0
    BenchPrint(A)
    BenchRts()
    ProcedureReturn 1
  EndIf
  If addr = $E16F
    n = M($B7)
    If n > 31 : n = 31 : EndIf
    For i = 0 To n - 1
      c = M(((M($BB) | (M($BC) << 8)) + i) & $FFFF)
      If c >= 65 And c <= 90 : c = c + 32 : EndIf
      BenchName(i) = c
    Next
    BenchNameLen = n
    rec = BenchFile(@BenchName(0), n)
    If rec = 0
      BenchEvent(2, 0)
      BenchFinished = 1 : Stopped = 1
    Else
      BenchLoad(rec)
      CpuPop(Lo) : CpuPop(Hi)
      PC = $0816
    EndIf
    ProcedureReturn 1
  EndIf
  If addr = $FFE4
    BenchFailures = BenchFailures + 1
    BenchEvent(3, BenchCurrent)
    A = 3
    BenchRts()
    ProcedureReturn 1
  EndIf
  If addr = $8000 Or addr = $A474
    BenchEvent(4, 0)
    BenchFinished = 1 : Stopped = 1
    ProcedureReturn 1
  EndIf
  ProcedureReturn 0
EndProcedure

; Start the named test (name at nameAdr, n bytes) on a freshly reset machine.
Procedure.i BenchStart(nameAdr.i, n.i)
  Protected rec.i
  BenchMode = 1
  BenchRoms()
  C64PowerOn()
  rec = BenchFile(nameAdr, n)
  If rec = 0 : ProcedureReturn 0 : EndIf
  BenchLoad(rec)
  S = $FD : CpuSetStatus($04) : PC = $0801
  ProcedureReturn 1
EndProcedure

DataSection
BenchIrq:
  Data.a $02 ; (an interrupt entry / exit: a trap the host answers - no ROM code here)
EndDataSection
