; GENERATED by tools/port_desktop.py from src/vic.pmi - do not edit; regenerate.
; The VIC-II (6569 PAL / 6567 NTSC), a line at a time.
;
; The line logic follows the chip's documented sequence (C. Bauer, "The MOS
; 6567/6569 video controller (VIC-II) and its application in the Commodore 64"):
; the badline condition, VCBASE / VC / RC with display and idle states, the
; sprites' DMA / display / MCBASE / expansion flip-flop at cycles 15, 16, 55, 56
; and 58, and the vertical border flip-flop. Each line is drawn at cycle 14 with
; the registers as the CPU has left them by then, so a raster IRQ's colour
; change takes effect on the next line, as on the real chip.
;
; The picture is 384 pixels by VicViewH lines. Pixel 0 is VIC x = -8 (sprite X
; 496), pixel 32 is x = 24, the display window's left edge. A pixel is a colour
; index 0..15, plus 16 where the graphics are foreground (sprite priority and
; the sprite-background collision use it; the platform's palette ignores it).
#VIC_W = 384
Global Dim VicReg.i(64)
Global Dim VmLine.i(40)
Global Dim ColLine.i(40)
Global Dim VicMap.i(4)
Global Dim SprDma.i(8)
Global Dim SprDisp.i(8)
Global Dim SprMcBase.i(8)
Global Dim SprMc.i(8)
Global Dim SprFF.i(8)
Global Dim SprData.i(8)
Global Dim SprOcc.a(448)
Global VicRaster.i, VicCompare.i, VicIrqFlags.i, VicIrqMask.i
Global VicDenSeen.i, VicVcBase.i, VicVc.i, VicRc.i, VicDisplay.i, VicVBorder.i = 1
Global VicSprSpr.i, VicSprBg.i, VicViewY0.i = 15, VicViewH.i = 272
Global VicLinesDrawn.i, VicSprActive.i = 1

; THE TWO SIDES. The chip's logic (raster, badlines, VC / RC, the border flip-flops, the sprites' DMA)
; runs with the CPU (core 0 on a Pico). At each visible line's cycle 14 it writes a RECORD: the 48
; registers as the CPU has left them, that state, the bank map, the row's characters and colours (a
; row ring, one row a badline) and the sprites' data. The DRAWING side (core 1 on a Pico; on the
; desktop at once, on the same thread) copies a record into the D... variables and draws the line from
; them; the line's collisions go back in the record and core 0 sets $D01E / $D01F and the IRQ.
; The drawing reads the character, bitmap and sprite-pointer memory when it draws, a few lines after
; the real chip would on a Pico - visible only if a program rewrites them under the beam.
#VREC = 16
#VREC_W = 72
#VROWS = 8
Global Dim VRec.i(#VREC * #VREC_W)
Global Dim VRow.i(#VROWS * 80)
Global VicRecHead.i, VicRecDone.i, VicRecMerged.i, VicRowHead.i
; the drawing side's copy of the line
Global Dim DVm.i(40)
Global Dim DCol.i(40)
; the record being drawn is read where it lies (DRecK: its first entry) - no copy of the registers
Global DRecK.i
Macro DReg(n)
  VRec(DRecK + 21 + (n))
EndMacro
Macro DMap(n)
  VRec(DRecK + 6 + (n))
EndMacro
Macro DSprData(n)
  VRec(DRecK + 10 + (n))
EndMacro
Macro DSprDisp(n)
  ((VRec(DRecK + 18) >> (n)) & 1)
EndMacro
Global DOut.i, DVy.i, DRaster.i, DRc.i, DVc.i, DDisplay.i, DVBorder.i, DSprActive.i, DRowLoaded.i = -1
Global DSS.i, DSB.i
; Eight pixels a cell as two 32-bit stores: Mask4(n) has byte k = $FF where bit 3-k of n is
; set (the leftmost pixel is the lowest byte). Cells are stored
; as words when there is no X scroll, else byte by byte.
Global Dim Mask4.l(16)
; a multicolour cell's four colours, each doubled into a 2-pixel half-word
Global Dim PairW.l(4)
; this line's sprites: span start / end in the line buffer, and whether another sprite's span meets it
; multicolour text: MCTab(n) is the 4-pixel word for nibble n with the line's colours 0-2 (pair 3
; left 0), MP3(n) the mask of its pair-3 pixels; MCKey says which colours MCTab was built for
Global Dim MCTab.l(16)
Global Dim MP3.l(16)
; multicolour foreground (pairs 2 and 3) of a nibble, for the black invalid modes
Global Dim MPFg.l(16)
Global MCKey.i = -1
; text cells by table: TxTab(colour << 4 | nibble) is the finished 4-pixel word of a cell of that
; colour RAM value. Standard text (TxMode 0) for background TxKey; multicolour text (TxMode 1)
; for the background colours 0-2 in TxKey. Rebuilt when the line's mode or colours differ.
Global Dim TxTab.l(256)
Global TxKey.i = -1
; tables built this frame: past 4 (raster bars changing the background every few lines) a line is
; drawn cell by cell instead
Global TxBuilds.i, TxRasterSeen.i
Global Dim SprPos.i(8)
Global Dim SprEnd.i(8)
Global Dim SprLap.i(8)

Procedure.i VicIrqActive()
  ProcedureReturn VicIrqFlags & VicIrqMask & 15
EndProcedure

Procedure VicBankChanged()
  Protected bank.i, blk.i
  bank = 3 - ((CiaPra(1) | (~CiaDdra(1))) & 3)
  For blk = 0 To 3
    VicMap(blk) = @M(0) + bank * $4000
  Next
  If C64Ultimax
    If CartRomH : VicMap(3) = CartRomH + $1000 - $3000 : EndIf
  ElseIf (bank & 1) = 0
    VicMap(1) = @RomChar(0) - $1000
  EndIf
EndProcedure

Macro VicMem(adr)
  PeekA(VicMap(((adr) >> 12) & 3) + ((adr) & $3FFF))
EndMacro
; the same read on the drawing side, through the bank map of the line being drawn
Macro DVicMem(adr)
  PeekA(DMap(((adr) >> 12) & 3) + ((adr) & $3FFF))
EndMacro

Procedure VicReset()
  Protected i.i, k.i, m.i
  For i = 0 To 15
    m = 0
    For k = 0 To 3
      If (i >> (3 - k)) & 1 : m = m | ($FF << (k * 8)) : EndIf
    Next
    Mask4(i) = m
    ; pair 3 (both bits set) in the high or low half of the nibble
    m = 0
    If (i >> 2) = 3 : m = m | $FFFF : EndIf
    If (i & 3) = 3 : m = m | $FFFF0000 : EndIf
    MP3(i) = m
    m = 0
    If i & 8 : m = m | $FFFF : EndIf
    If i & 2 : m = m | $FFFF0000 : EndIf
    MPFg(i) = m
  Next
  MCKey = -1 : TxKey = -1
  For i = 0 To 63 : VicReg(i) = 0 : Next
  For i = 0 To 7
    SprDma(i) = 0 : SprDisp(i) = 0 : SprMcBase(i) = 0 : SprMc(i) = 0 : SprFF(i) = 1 : SprData(i) = 0
  Next
  VicRaster = 0 : VicCompare = 0 : VicIrqFlags = 0 : VicIrqMask = 0
  VicDenSeen = 0 : VicVcBase = 0 : VicVc = 0 : VicRc = 0 : VicDisplay = 0 : VicVBorder = 1
  VicSprSpr = 0 : VicSprBg = 0
  If C64Pal
    VicViewY0 = 15 : VicViewH = 272
  Else
    VicViewY0 = 21 : VicViewH = 242
  EndIf
  VicBankChanged()
EndProcedure

Procedure VicCompareCheck()
  If VicRaster = VicCompare
    VicIrqFlags = VicIrqFlags | 1
  EndIf
EndProcedure

Procedure.i VicRead(reg.i)
  Protected v.i
  If reg = $11 : ProcedureReturn (VicReg($11) & $7F) | ((VicRaster & $100) >> 1) : EndIf
  If reg = $12 : ProcedureReturn VicRaster & 255 : EndIf
  If reg = $16 : ProcedureReturn VicReg($16) | $C0 : EndIf
  If reg = $18 : ProcedureReturn VicReg($18) | 1 : EndIf
  If reg = $19
    v = VicIrqFlags | $70
    If VicIrqActive() : v = v | $80 : EndIf
    ProcedureReturn v
  EndIf
  If reg = $1A : ProcedureReturn VicIrqMask | $F0 : EndIf
  If reg = $1E
    v = VicSprSpr : VicSprSpr = 0
    ProcedureReturn v
  EndIf
  If reg = $1F
    v = VicSprBg : VicSprBg = 0
    ProcedureReturn v
  EndIf
  If reg >= $20 And reg <= $2E : ProcedureReturn VicReg(reg) | $F0 : EndIf
  If reg >= $2F : ProcedureReturn $FF : EndIf
  ProcedureReturn VicReg(reg)
EndProcedure

Procedure VicWrite(reg.i, v.i)
  Protected old.i
  v = v & 255
  If reg = $11 Or reg = $12
    VicReg(reg) = v
    old = VicCompare
    VicCompare = ((VicReg($11) & $80) << 1) | VicReg($12)
    If VicCompare <> old : VicCompareCheck() : EndIf
    If VicRaster = $30 And (VicReg($11) & $10) : VicDenSeen = 1 : EndIf
    C64UpdateIrq(CpuNow())
    ProcedureReturn
  EndIf
  If reg = $19
    VicIrqFlags = VicIrqFlags & (~v) & 15
    C64UpdateIrq(CpuNow())
    ProcedureReturn
  EndIf
  If reg = $1A
    VicIrqMask = v & 15
    C64UpdateIrq(CpuNow())
    ProcedureReturn
  EndIf
  If reg = $1E Or reg = $1F : ProcedureReturn : EndIf
  If reg < $2F : VicReg(reg) = v : EndIf
EndProcedure

Procedure.i VicBadCondition()
  If VicRaster >= $30 And VicRaster <= $F7 And VicDenSeen
    If (VicRaster & 7) = (VicReg($11) & 7) : ProcedureReturn 1 : EndIf
  EndIf
  ProcedureReturn 0
EndProcedure

; Cycle 0: the raster counter moves on, the raster compare, the badline, and
; the cycles the sprites' DMA takes from the CPU on this line.
Procedure VicStartLine()
  Protected n.i, count.i
  VicRaster = VicLine
  If VicRaster = 0 : VicDenSeen = 0 : EndIf
  If VicRaster = $30 And (VicReg($11) & $10) : VicDenSeen = 1 : EndIf
  VicCompareCheck()
  VicBad = VicBadCondition()
  count = 0
  If VicSprActive
    For n = 0 To 7
      If SprDma(n) : count = count + 1 : EndIf
    Next
  EndIf
  VicSpriteSteal = 0
  If count : VicSpriteSteal = count * 2 + 3 : EndIf
  ; the raster interrupt comes at cycle 0 of the line (cycle 1 on line 0)
  If VicRaster = 0 : C64UpdateIrq(C64LineStart + 1) : Else : C64UpdateIrq(C64LineStart) : EndIf
EndProcedure

Procedure.i VicSprites()
  Protected n.i, m.i, pos.i, wid.i, q.i, sbits.i, rep.i, mc.i, prio.i, col.i, i.i, k.i, c.i
  Protected old.i, ss.i, sb.i, any.i, j.i, lap.i, occ.i, bit.i, c1.i, c3.i
  If DSprActive = 0 : ProcedureReturn 0 : EndIf
  any = 0
  For n = 0 To 7
    If DSprDisp(n)
      pos = (DReg(n * 2) | (((DReg($10) >> n) & 1) << 8)) + 8
      If pos >= 504 : pos = pos - 504 : EndIf
      SprPos(n) = pos
      SprEnd(n) = pos + (24 << ((DReg($1D) >> n) & 1))
      any = any + 1
    EndIf
  Next
  If any = 0 : ProcedureReturn 0 : EndIf
  ; sprite-sprite collisions need the occupancy buffer only where two sprites' spans meet
  For n = 0 To 7
    SprLap(n) = 0
    If DSprDisp(n) And any > 1
      For m = 0 To 7
        If m <> n And DSprDisp(m)
          If SprPos(m) < SprEnd(n) And SprPos(n) < SprEnd(m) : SprLap(n) = 1 : EndIf
        EndIf
      Next
      If SprLap(n)
        q = SprEnd(n) : If q > #VIC_W : q = #VIC_W : EndIf
        For i = SprPos(n) To q - 1 : SprOcc(i) = 0 : Next
      EndIf
    EndIf
  Next
  ss = 0 : sb = 0
  c1 = DReg($25) & 15 : c3 = DReg($26) & 15
  For n = 7 To 0 Step -1
    If DSprDisp(n) = 0 : Continue : EndIf
    sbits = DSprData(n)
    If sbits = 0 : Continue : EndIf
    pos = SprPos(n) : lap = SprLap(n) : bit = 1 << n
    rep = 1 + ((DReg($1D) >> n) & 1)
    mc = (DReg($1C) >> n) & 1
    prio = (DReg($1B) >> n) & 1
    col = DReg($27 + n) & 15
    If mc
      rep = rep * 2
      For i = 0 To 11
        k = (sbits >> (22 - i * 2)) & 3
        If k
          If k = 1 : c = c1 : ElseIf k = 2 : c = col : Else : c = c3 : EndIf
          q = pos + i * rep
          For j = 1 To rep
            If q < #VIC_W
              If lap
                occ = SprOcc(q)
                If occ : ss = ss | occ | bit : EndIf
                SprOcc(q) = occ | bit
              EndIf
              old = PeekA(DOut + q)
              If old & 16
                sb = sb | bit
                If prio = 0 : PokeA(DOut + q, c | 16) : EndIf
              Else
                PokeA(DOut + q, c)
              EndIf
            EndIf
            q = q + 1
          Next
        EndIf
      Next
    Else
      For i = 0 To 23
        If sbits & ($800000 >> i)
          q = pos + i * rep
          For j = 1 To rep
            If q < #VIC_W
              If lap
                occ = SprOcc(q)
                If occ : ss = ss | occ | bit : EndIf
                SprOcc(q) = occ | bit
              EndIf
              old = PeekA(DOut + q)
              If old & 16
                sb = sb | bit
                If prio = 0 : PokeA(DOut + q, col | 16) : EndIf
              Else
                PokeA(DOut + q, col)
              EndIf
            EndIf
            q = q + 1
          Next
        EndIf
      Next
    EndIf
  Next
  ; the collisions go back with the line's record; core 0 sets the registers and the IRQ
  DSS = ss : DSB = sb
  ProcedureReturn 1
EndProcedure

; Fill [from, upto) of the line with colour c: bytes to a word boundary, then words.
Procedure VicFill(from.i, upto.i, c.i)
  Protected ad.i, en.i, w.i
  ad = DOut + from : en = DOut + upto
  While (ad & 3) <> 0 And ad < en : PokeA(ad, c) : ad = ad + 1 : Wend
  w = c * $01010101
  While ad + 4 <= en : PokeL(ad, w) : ad = ad + 4 : Wend
  While ad < en : PokeA(ad, c) : ad = ad + 1 : Wend
EndProcedure

; The 40 cells of a display line (or the idle pattern), every mode, as two 32-bit words a
; cell: stored as words when there is no X scroll (the line is word-aligned), else as bytes.
; Standard text, the common screen, has a loop of its own.
; the bytes a shifted line pushed past its last cell, into the word after it
Procedure VicTxBuild(key.i)
  Protected cl.i, nb.i, f.i, b.i, m.i, w.i, b1.i, b2.i, p1.i, p2.i
  TxKey = key
  b = (key & 15) * $01010101
  If key & $10000
    ; multicolour text: colour RAM 8-15 multicolour (pair 3 = colour & 7), 0-7 hires
    p1 = ((key >> 4) & 15) * $0101 : p2 = (((key >> 8) & 15) | 16) * $0101
    b1 = (key & 15) * $0101
    For cl = 0 To 15
      f = ((cl & 7) | 16) * $01010101
      For nb = 0 To 15
        If cl & 8
          w = 0
          m = (nb >> 2) & 3
          If m = 0 : w = b1 : ElseIf m = 1 : w = p1 : ElseIf m = 2 : w = p2 : Else : w = ((cl & 7) | 16) * $0101 : EndIf
          m = nb & 3
          If m = 0 : w = w | (b1 << 16) : ElseIf m = 1 : w = w | (p1 << 16) : ElseIf m = 2 : w = w | (p2 << 16) : Else : w = w | ((((cl & 7) | 16) * $0101) << 16) : EndIf
        Else
          m = Mask4(nb) : w = (m & f) | ((~m) & b)
        EndIf
        TxTab((cl << 4) | nb) = w
      Next
    Next
  Else
    For cl = 0 To 15
      f = (cl | 16) * $01010101
      For nb = 0 To 15
        m = Mask4(nb) : TxTab((cl << 4) | nb) = (m & f) | ((~m) & b)
      Next
    Next
  EndIf
EndProcedure

Procedure VicCellsTail(ad.i, sh.i, cy.i)
  If sh
    PokeL(ad, (PeekL(ad) & ~((1 << sh) - 1)) | cy)
  EndIf
EndProcedure

Procedure VicCells(mode.i, xs.i, cb.i, bb.i)
  Protected i.i, g.i, c.i, col.i, f.i, b.i, gp.i, m.i, w0.i, w1.i, bg0.i, k.i, mc.i, chp.i
  Protected p0.i, p1.i, p2.i, p3.i, sh.i, rsh.i, cy.i
  bg0 = DReg($21) & 15
  If mode >= 5 : bg0 = 0 : EndIf
  ; the cells are stored as aligned words: an X scroll of xs pixels starts a word later for 4-7,
  ; shifts each word left by the rest (xs & 3) bytes and carries the bytes pushed out into the next
  ; word (the xs bytes before the first cell and those after the last keep what is there)
  gp = DOut + 32 + (xs & 4)
  sh = (xs & 3) << 3
  If sh
    rsh = 32 - sh
    cy = PeekL(gp) & ((1 << sh) - 1)
  EndIf
  ; the line's character data: one 2 KB set inside one 4 KB block of the VIC's bank
  chp = DMap((cb >> 12) & 3) + cb + DRc
  ; standard and multicolour text: two table words a cell
  k = bg0
  If mode = 1 : k = k | ((DReg($22) & 15) << 4) | ((DReg($23) & 15) << 8) | $10000 : EndIf
  If mode <= 1 And DDisplay
    If DRaster < TxRasterSeen : TxBuilds = 0 : EndIf
    TxRasterSeen = DRaster
    If k <> TxKey And TxBuilds < 4 : VicTxBuild(k) : TxBuilds = TxBuilds + 1 : EndIf
  EndIf
  If mode <= 1 And DDisplay And k = TxKey
    If sh = 0
      For i = 0 To 39
        g = PeekA(chp + (DVm(i) << 3))
        c = (DCol(i) & 15) << 4
        PokeL(gp, TxTab(c | (g >> 4))) : PokeL(gp + 4, TxTab(c | (g & 15)))
        gp = gp + 8
      Next
      ProcedureReturn
    EndIf
    For i = 0 To 39
      g = PeekA(chp + (DVm(i) << 3))
      c = (DCol(i) & 15) << 4
      w0 = TxTab(c | (g >> 4)) : w1 = TxTab(c | (g & 15))
      PokeL(gp, (w0 << sh) | cy) : PokeL(gp + 4, (w1 << sh) | (w0 >> rsh)) : cy = w1 >> rsh
      gp = gp + 8
    Next
    VicCellsTail(gp, sh, cy)
    ProcedureReturn
  EndIf
  ; standard text with no table this line: the colour word computed a cell
  If mode = 0 And DDisplay
    b = bg0 * $01010101
    For i = 0 To 39
      g = PeekA(chp + (DVm(i) << 3))
      If g
        f = (DCol(i) | 16) * $01010101
        m = Mask4(g >> 4)
        w0 = (m & f) | ((~m) & b)
        m = Mask4(g & 15)
        w1 = (m & f) | ((~m) & b)
      Else
        w0 = b : w1 = b
      EndIf
      If sh = 0
        PokeL(gp, w0) : PokeL(gp + 4, w1)
      Else
        PokeL(gp, (w0 << sh) | cy) : PokeL(gp + 4, (w1 << sh) | (w0 >> rsh)) : cy = w1 >> rsh
      EndIf
      gp = gp + 8
    Next
    VicCellsTail(gp, sh, cy)
    ProcedureReturn
  EndIf
  ; multicolour text (and its hires cells) and multicolour bitmap: the colours that are the
  ; same for the whole line are set once
  If (mode = 1 Or mode = 3) And DDisplay
    b = bg0 * $01010101
    PairW(0) = bg0 * $0101
    If mode = 1
      PairW(1) = (DReg($22) & 15) * $0101 : PairW(2) = ((DReg($23) & 15) | 16) * $0101
      k = bg0 | ((DReg($22) & 15) << 4) | ((DReg($23) & 15) << 8)
      If k <> MCKey
        ; the table for this line's background colours (rebuilt only when they change)
        MCKey = k : PairW(3) = 0
        For i = 0 To 15
          MCTab(i) = PairW((i >> 2) & 3) | (PairW(i & 3) << 16)
        Next
      EndIf
    EndIf
    For i = 0 To 39
      c = DVm(i) : col = DCol(i)
      If mode = 1
        g = PeekA(chp + (c << 3))
        If col & 8
          f = ((col & 7) | 16) * $01010101
          w0 = MCTab(g >> 4) | (MP3(g >> 4) & f)
          w1 = MCTab(g & 15) | (MP3(g & 15) & f)
        Else
          f = ((col & 7) | 16) * $01010101
          m = Mask4((g >> 4) & 15) : w0 = (m & f) | ((~m) & b)
          m = Mask4(g & 15) : w1 = (m & f) | ((~m) & b)
        EndIf
      Else
        g = DVicMem(bb + (((DVc + i) & $3FF) << 3) + DRc)
        PairW(1) = (c >> 4) * $0101 : PairW(2) = ((c & 15) | 16) * $0101 : PairW(3) = ((col & 15) | 16) * $0101
        w0 = PairW((g >> 6) & 3) | (PairW((g >> 4) & 3) << 16)
        w1 = PairW((g >> 2) & 3) | (PairW(g & 3) << 16)
      EndIf
      If sh = 0
        PokeL(gp, w0) : PokeL(gp + 4, w1)
      Else
        PokeL(gp, (w0 << sh) | cy) : PokeL(gp + 4, (w1 << sh) | (w0 >> rsh)) : cy = w1 >> rsh
      EndIf
      gp = gp + 8
    Next
    VicCellsTail(gp, sh, cy)
    ProcedureReturn
  EndIf
  ; the invalid modes (ECM with MCM or BMM) are black: a cell is only its foreground mask
  If mode >= 5 And DDisplay
    For i = 0 To 39
      c = DVm(i) : col = DCol(i)
      If mode = 6
        g = DVicMem(bb + (((DVc + i) & $3FF) << 3) + DRc)
      ElseIf mode = 7
        g = DVicMem(bb + (((DVc + i) & $3FF) << 3) + DRc)
      Else
        g = DVicMem(cb + ((c & $3F) << 3) + DRc)
      EndIf
      If mode = 7 Or (mode = 5 And (col & 8) <> 0)
        w0 = MPFg((g >> 4) & 15) & $10101010 : w1 = MPFg(g & 15) & $10101010
      Else
        w0 = Mask4((g >> 4) & 15) & $10101010 : w1 = Mask4(g & 15) & $10101010
      EndIf
      If sh = 0
        PokeL(gp, w0) : PokeL(gp + 4, w1)
      Else
        PokeL(gp, (w0 << sh) | cy) : PokeL(gp + 4, (w1 << sh) | (w0 >> rsh)) : cy = w1 >> rsh
      EndIf
      gp = gp + 8
    Next
    VicCellsTail(gp, sh, cy)
    ProcedureReturn
  EndIf
  If DDisplay = 0
    If mode & 4 : g = DVicMem($39FF) : Else : g = DVicMem($3FFF) : EndIf
  EndIf
  For i = 0 To 39
    If DDisplay
      c = DVm(i) : col = DCol(i)
      If mode & 2
        g = DVicMem(bb + (((DVc + i) & $3FF) << 3) + DRc)
      ElseIf mode & 4
        g = DVicMem(cb + ((c & $3F) << 3) + DRc)
      Else
        g = DVicMem(cb + (c << 3) + DRc)
      EndIf
    Else
      c = 0 : col = 0
    EndIf
    mc = 0
    If mode = 0
      f = col | 16 : b = bg0
    ElseIf mode = 1
      If col & 8
        mc = 1 : p0 = bg0 : p1 = DReg($22) & 15 : p2 = (DReg($23) & 15) | 16 : p3 = (col & 7) | 16
      Else
        f = (col & 7) | 16 : b = bg0
      EndIf
    ElseIf mode = 2
      f = (c >> 4) | 16 : b = c & 15
    ElseIf mode = 3
      mc = 1 : p0 = bg0 : p1 = c >> 4 : p2 = (c & 15) | 16 : p3 = (col & 15) | 16
    ElseIf mode = 4
      f = col | 16 : b = DReg($21 + (c >> 6)) & 15
    ElseIf mode = 5
      If col & 8
        mc = 1 : p0 = 0 : p1 = 0 : p2 = 16 : p3 = 16
      Else
        f = 16 : b = 0
      EndIf
    ElseIf mode = 6
      f = 16 : b = 0
    Else
      mc = 1 : p0 = 0 : p1 = 0 : p2 = 16 : p3 = 16
    EndIf
    If mc
      PairW(0) = p0 * $0101 : PairW(1) = p1 * $0101 : PairW(2) = p2 * $0101 : PairW(3) = p3 * $0101
      w0 = PairW((g >> 6) & 3) | (PairW((g >> 4) & 3) << 16)
      w1 = PairW((g >> 2) & 3) | (PairW(g & 3) << 16)
    Else
      f = f * $01010101 : b = b * $01010101
      m = Mask4((g >> 4) & 15)
      w0 = (m & f) | ((~m) & b)
      m = Mask4(g & 15)
      w1 = (m & f) | ((~m) & b)
    EndIf
    If DDisplay = 0
      ; idle: every cell of the line is the same pattern
      For k = 0 To 39
        If sh = 0
          PokeL(gp, w0) : PokeL(gp + 4, w1)
        Else
          PokeL(gp, (w0 << sh) | cy) : PokeL(gp + 4, (w1 << sh) | (w0 >> rsh)) : cy = w1 >> rsh
        EndIf
        gp = gp + 8
      Next
      VicCellsTail(gp, sh, cy)
      ProcedureReturn
    EndIf
    If sh = 0
      PokeL(gp, w0) : PokeL(gp + 4, w1)
    Else
      PokeL(gp, (w0 << sh) | cy) : PokeL(gp + 4, (w1 << sh) | (w0 >> rsh)) : cy = w1 >> rsh
    EndIf
    gp = gp + 8
  Next
  VicCellsTail(gp, sh, cy)
EndProcedure

; Cycle 14: the matrix fetch of a badline, the line's graphics, sprites and
; border, then the sprites' MCBASE steps of cycles 15 and 16.
; Draw the line of a record: the drawing side (core 1 on a Pico).
Procedure VicRender()
  Protected i.i, mode.i, c.i, cb.i, bb.i, xs.i, bc.i, lft.i, rgt.i, t0.i, t1.i
  DOut = PlatformLine(DVy)
  bc = DReg($20) & 15
  If DVBorder
    VicFill(0, #VIC_W, bc)
    ; sprites still collide under the border: draw them, then the border over them
    If VicSprites() : VicFill(0, #VIC_W, bc) : EndIf
  Else
    mode = ((DReg($11) >> 4) & 6) | ((DReg($16) >> 4) & 1)
    c = DReg($21) & 15
    If mode >= 5 : c = 0 : EndIf
    xs = DReg($16) & 7
    ; the scroll gap left of the first cell (every cell writes all its 8 pixels)
    For i = 32 To 31 + xs : PokeA(DOut + i, c) : Next
    cb = (DReg($18) & $0E) << 10
    bb = (DReg($18) & 8) << 10
    If PerfOn : t0 = PlatformUs() : EndIf
    VicCells(mode, xs, cb, bb)
    If PerfOn : t1 = PlatformUs() : PerfCellUs = PerfCellUs + t1 - t0 : EndIf
    VicSprites()
    If PerfOn : PerfSprUs = PerfSprUs + PlatformUs() - t1 : EndIf
    If DReg($16) & 8
      lft = 32 : rgt = 352
    Else
      lft = 39 : rgt = 343
    EndIf
    VicFill(0, lft, bc)
    VicFill(rgt, #VIC_W, bc)
  EndIf
  PlatformLineDone(DVy)
EndProcedure

; The drawing side: the next record (there must be one), drawn from where it lies, its collisions
; back in the record, done.
Procedure VicRenderNext()
  Protected k.i, i.i, r.i, m.i
  PlatformFence()
  k = (VicRecDone & (#VREC - 1)) * #VREC_W
  DVy = VRec(k) : DRaster = VRec(k + 1)
  m = VRec(k + 2)
  DVBorder = m & 1 : DDisplay = (m >> 1) & 1 : DSprActive = (m >> 2) & 1
  DRc = VRec(k + 3) : DVc = VRec(k + 4)
  r = VRec(k + 5)
  If r <> DRowLoaded
    m = (r & (#VROWS - 1)) * 80
    For i = 0 To 39 : DVm(i) = VRow(m + i) : DCol(i) = VRow(m + 40 + i) : Next
    DRowLoaded = r
  EndIf
  DRecK = k
  DSS = 0 : DSB = 0
  VicRender()
  VRec(k + 19) = DSS : VRec(k + 20) = DSB
  PlatformFence()
  VicRecDone = VicRecDone + 1
EndProcedure

; Core 0: the collisions of the lines drawn since the last call, into $D01E / $D01F and the IRQ.
Procedure VicMergeCollisions()
  Protected k.i, ss.i, sb.i
  While VicRecMerged <> PeekL(@VicRecDone)
    PlatformFence()
    k = (VicRecMerged & (#VREC - 1)) * #VREC_W
    ss = VRec(k + 19) : sb = VRec(k + 20)
    If ss
      If VicSprSpr = 0 : VicIrqFlags = VicIrqFlags | 4 : EndIf
      VicSprSpr = VicSprSpr | ss
    EndIf
    If sb
      If VicSprBg = 0 : VicIrqFlags = VicIrqFlags | 2 : EndIf
      VicSprBg = VicSprBg | sb
    EndIf
    If ss Or sb : C64UpdateIrq(C64Clock) : EndIf
    VicRecMerged = VicRecMerged + 1
  Wend
EndProcedure

; Cycle 14: the chip's line logic, and a visible line's record for the drawing side.
Procedure VicDrawLine()
  Protected i.i, n.i, mb.i, top.i, bottom.i, vy.i, k.i, r.i
  If VicRaster = $30 And (VicReg($11) & $10) : VicDenSeen = 1 : EndIf
  VicBad = VicBadCondition()
  If VicRaster = 0 : VicVcBase = 0 : EndIf
  VicVc = VicVcBase
  mb = (VicReg($18) & $F0) << 6
  If VicBad
    VicDisplay = 1 : VicRc = 0
    For i = 0 To 39
      VmLine(i) = VicMem(mb + ((VicVc + i) & $3FF))
      ColLine(i) = ColorRam((VicVc + i) & $3FF) & 15
    Next
    ; the row for the drawing side
    VicRowHead = VicRowHead + 1
    r = (VicRowHead & (#VROWS - 1)) * 80
    For i = 0 To 39 : VRow(r + i) = VmLine(i) : VRow(r + 40 + i) = ColLine(i) : Next
  EndIf
  ; the vertical border flip-flop
  If VicReg($11) & 8
    top = 51 : bottom = 251
  Else
    top = 55 : bottom = 247
  EndIf
  If VicRaster = bottom : VicVBorder = 1 : EndIf
  If VicRaster = top And (VicReg($11) & $10) : VicVBorder = 0 : EndIf
  vy = VicRaster - VicViewY0
  If vy >= 0 And vy < VicViewH
    If VicRecHead - PeekL(@VicRecDone) >= #VREC : PlatformRecordWait() : EndIf
    k = (VicRecHead & (#VREC - 1)) * #VREC_W
    VRec(k) = vy : VRec(k + 1) = VicRaster
    VRec(k + 2) = VicVBorder | (VicDisplay << 1) | (VicSprActive << 2)
    VRec(k + 3) = VicRc : VRec(k + 4) = VicVc : VRec(k + 5) = VicRowHead
    For i = 0 To 3 : VRec(k + 6 + i) = VicMap(i) : Next
    For i = 0 To 7 : VRec(k + 10 + i) = SprData(i) : Next
    n = 0
    For i = 0 To 7
      If SprDisp(i) : n = n | (1 << i) : EndIf
    Next
    VRec(k + 18) = n
    For i = 0 To 47 : VRec(k + 21 + i) = VicReg(i) : Next
    PlatformFence()
    VicRecHead = VicRecHead + 1
    VicLinesDrawn = VicLinesDrawn + 1
    PlatformRecord()
  EndIf
  VicMergeCollisions()
  If VicDisplay : VicVc = (VicVc + 40) & $3FF : EndIf
  If VicSprActive = 0 : ProcedureReturn : EndIf
  For n = 0 To 7
    If SprFF(n)
      SprMcBase(n) = (SprMcBase(n) + 3) & 63
      If SprMcBase(n) = 63 : SprDma(n) = 0 : SprDisp(n) = 0 : EndIf
    EndIf
  Next
EndProcedure

; Cycles 55-58: the sprites' expansion flip-flops, DMA start, MC and display,
; their sbits fetched for the next line; RC and VCBASE.
Procedure VicEndLine()
  Protected n.i, ye.i, ptr.i, mb.i, adr.i
  mb = (VicReg($18) & $F0) << 6
  ; no sprite enabled and none still running: nothing to do here (VicSprActive keeps the loops off)
  VicSprActive = Bool(VicReg($15) <> 0)
  For n = 0 To 7
    If SprDma(n) Or SprDisp(n) : VicSprActive = 1 : EndIf
  Next
  If VicSprActive = 0 : Goto VicEndRows : EndIf
  For n = 0 To 7
    ; a sprite that is off, not fetching and not shown has nothing to do here
    If ((VicReg($15) >> n) & 1) = 0 And SprDma(n) = 0 And SprDisp(n) = 0 : Continue : EndIf
    ye = (VicReg($17) >> n) & 1
    If ye : SprFF(n) = 1 - SprFF(n) : Else : SprFF(n) = 1 : EndIf
    If (VicReg($15) >> n) & 1
      If SprDma(n) = 0 And VicReg(n * 2 + 1) = (VicRaster & 255)
        SprDma(n) = 1 : SprMcBase(n) = 0
        If ye : SprFF(n) = 0 : EndIf
      EndIf
    EndIf
    SprMc(n) = SprMcBase(n)
    If SprDma(n)
      If VicReg(n * 2 + 1) = (VicRaster & 255) : SprDisp(n) = 1 : EndIf
      ptr = VicMem(mb + $3F8 + n) << 6
      adr = ptr + SprMc(n)
      SprData(n) = (VicMem(adr) << 16) | (VicMem(adr + 1) << 8) | VicMem(adr + 2)
      SprMc(n) = SprMc(n) + 3
    EndIf
  Next
VicEndRows:
  If VicRc = 7
    VicVcBase = VicVc
    VicDisplay = VicBadCondition()
  EndIf
  If VicDisplay : VicRc = (VicRc + 1) & 7 : EndIf
EndProcedure
