  Value = M(Ea)
  Tmp = ((FC >> 8) & 1) ! 1
  Res = A - Value - Tmp
  FV = (A ! Value) & (A ! Res)
  FC = ~Res
  FN = Res
  FZ = Res & 255
  If FD
    Lo = (A & 15) - (Value & 15) - Tmp
    Hi = (A & $F0) - (Value & $F0)
    If Lo < 0 : Lo = ((Lo - 6) & 15) - 16 : EndIf
    Hi = Hi + Lo
    If Hi < 0 : Hi = Hi - $60 : EndIf
    A = Hi & 255
  Else
    A = Res & 255
  EndIf
  Left = Left - 4
  CpuInstructions = CpuInstructions + 1
EndProcedure
Procedure OpF6() ; $F6 INC zpx
  Pg = RdMap(PC >> 8)
  If Pg : Ea = PeekA(Pg + PC) : Else : AccessPhase = 1 : Ea = C64IoRead(PC) : EndIf
  PC = (PC + 1) & $FFFF
  Ea = (Ea + X) & 255
  Value = M(Ea)
  Res = (Value + 1) & 255
  FN = Res
  FZ = Res
  If Ea < 2 : C64PortWrite(Ea, Res) : Else : M(Ea) = Res : EndIf
  Left = Left - 6
  CpuInstructions = CpuInstructions + 1
EndProcedure
