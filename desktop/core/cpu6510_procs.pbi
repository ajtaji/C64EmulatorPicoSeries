Procedure Op61() ; $61 ADC izx
  Pg = RdMap(PC >> 8)
  If Pg : Tmp = PeekA(Pg + PC) : Else : AccessPhase = 1 : Tmp = C64IoRead(PC) : EndIf
  PC = (PC + 1) & $FFFF
  Tmp = (Tmp + X) & 255
  Ea = M(Tmp) | (M((Tmp + 1) & 255) << 8)
  Pg = RdMap(Ea >> 8)
  If Pg : Value = PeekA(Pg + Ea) : Else : AccessPhase = 5 : Value = C64IoRead(Ea) : EndIf
  Res = A + Value + ((FC >> 8) & 1)
  If FD
    FZ = Res
    Lo = (A & 15) + (Value & 15) + ((FC >> 8) & 1)
    If Lo > 9 : Lo = ((Lo + 6) & 15) + 16 : EndIf
    Hi = (A & $F0) + (Value & $F0) + Lo
    FN = Hi
    FV = (~(A ! Value)) & (A ! Hi)
    If Hi > $9F : Hi = Hi + $60 : EndIf
    FC = 0
    If Hi > 255 : FC = $100 : EndIf
    A = Hi & 255
  Else
    FV = (~(A ! Value)) & (A ! Res)
    FC = Res
    A = Res & 255
    FN = A
    FZ = A
  EndIf
  Left = Left - 6
  CpuInstructions = CpuInstructions + 1
EndProcedure
