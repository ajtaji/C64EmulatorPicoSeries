Procedure OpF9() ; $F9 SBC aby
  Pg = RdMap(PC >> 8)
  If Pg : Lo = PeekA(Pg + PC) : Else : AccessPhase = 1 : Lo = C64IoRead(PC) : EndIf
  PC = (PC + 1) & $FFFF
  Pg = RdMap(PC >> 8)
  If Pg : Hi = PeekA(Pg + PC) : Else : AccessPhase = 2 : Hi = C64IoRead(PC) : EndIf
  PC = (PC + 1) & $FFFF
  Ea = Lo | (Hi << 8)
  Base = Ea
  Ea = (Ea + Y) & $FFFF
  If (Base & $FF00) <> (Ea & $FF00) : Left = Left - 1 : EndIf
  Pg = RdMap(Ea >> 8)
  If Pg : Value = PeekA(Pg + Ea) : Else : AccessPhase = 3 : Value = C64IoRead(Ea) : EndIf
  Tmp = ((FC >> 8) & 1) ! 1
  Res = A - Value - Tmp
  FV = (A ! Value) & (A ! Res)
  FC = ~Res
  FN = Res
  FZ = Res & 255
  If FD
    Lo = (A & 15) - (Value & 15) - Tmp
    Hi = (A & $F0) - (Value & $F0)
    If Lo < 0 : Lo = ((Lo - 6) & 15) - 16 : EndIf
    Hi = Hi + Lo
    If Hi < 0 : Hi = Hi - $60 : EndIf
    A = Hi & 255
  Else
    A = Res & 255
  EndIf
  Left = Left - 4
  CpuInstructions = CpuInstructions + 1
EndProcedure
