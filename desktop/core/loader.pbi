; GENERATED by tools/port_desktop.py from src/loader.pico - do not edit; regenerate.
; Programs into the machine: a .PRG put straight into RAM, and a .D64 disk
; through a trap on the KERNAL's LOAD (the entry behind the $0330 vector, so a
; program that installs its own loader there is left alone). Device 8 only;
; true 1541 emulation (fast loaders that talk to the drive) is not here yet.
;
; The trap: the byte at $F4A5 (STA $93, the first instruction of the KERNAL's
; LOAD) becomes $02, which the CPU hands to C64Trap. Declining runs STA $93.
#TRAP_LOAD = $F4A5
Global D64Image.i, D64Size.i, D64Inserted.i
Global LoadTrapOn.i, LoadCount.i, LoadLastEnd.i, LoadError.i
Global PrgPending.i, PrgPendingSize.i, PrgAutoRun.i, PrgFrame.i
Global Dim TypeQueue.a(256)
Global TypeHead.i, TypeTail.i
Global Dim LoadName.a(20)
Global LoadNameLen.i
Declare C64InjectPrg(prg.i, size.i, autorun.i)
Declare.i C64PutText(p.i, text.i)

; The ROMs: 8 KB BASIC, 8 KB KERNAL, 4 KB character ROM, copied from wherever
; the platform keeps them. The KERNAL copy gets the LOAD trap.
Procedure C64SetRoms(basic.i, kernal.i, chars.i)
  Protected i.i
  For i = 0 To 8191 : RomBasic(i) = PeekA(basic + i) : RomKernal(i) = PeekA(kernal + i) : Next
  For i = 0 To 4095 : RomChar(i) = PeekA(chars + i) : Next
  C64RomsLoaded = 1
  LoadTrapOn = 0
  If RomKernal(#TRAP_LOAD - $E000) = $85 And RomKernal(#TRAP_LOAD - $E000 + 1) = $93
    RomKernal(#TRAP_LOAD - $E000) = $02
    LoadTrapOn = 1
  EndIf
EndProcedure

Procedure C64Type(c.i)
  If ((TypeTail + 1) & 255) <> (TypeHead & 255)
    TypeQueue(TypeTail & 255) = c
    TypeTail = (TypeTail + 1) & 255
  EndIf
EndProcedure
Procedure C64TypeText(text.i)
  Protected c.i
  c = PeekA(text)
  While c
    C64Type(c)
    text = text + 1
    c = PeekA(text)
  Wend
EndProcedure

; ASCII to the keyboard buffer's PETSCII: letters to upper case (the C64's
; power-on character set), newline to RETURN.
Procedure.i C64Petscii(c.i)
  If c >= 97 And c <= 122 : ProcedureReturn c - 32 : EndIf
  If c = 10 : ProcedureReturn 13 : EndIf
  ProcedureReturn c
EndProcedure

; Once a frame: feed typed text into the KERNAL's keyboard buffer when it is
; empty, and put a pending .PRG in once BASIC has had time to start.
Procedure C64LoaderFrame()
  Protected n.i
  If PrgPending And C64Frame >= PrgFrame
    C64InjectPrg(PrgPending, PrgPendingSize, PrgAutoRun)
    PrgPending = 0
  EndIf
  If TypeHead <> TypeTail And M($C6) = 0 And C64Frame >= PrgFrame
    n = 0
    While TypeHead <> TypeTail And n < 8
      M($0277 + n) = C64Petscii(TypeQueue(TypeHead))
      TypeHead = (TypeHead + 1) & 255
      n = n + 1
    Wend
    M($C6) = n
  EndIf
EndProcedure

; A .PRG: two bytes of load address, then the bytes. A BASIC program ($0801)
; gets BASIC's end pointers set, and RUN typed when autorun is asked for.
Procedure C64InjectPrg(prg.i, size.i, autorun.i)
  Protected adr.i, i.i, fin.i
  If size < 3 : ProcedureReturn : EndIf
  adr = PeekA(prg) | (PeekA(prg + 1) << 8)
  For i = 2 To size - 1
    M((adr + i - 2) & $FFFF) = PeekA(prg + i)
  Next
  fin = (adr + size - 2) & $FFFF
  If adr = $0801
    M($2D) = fin & 255 : M($2E) = fin >> 8
    M($2F) = fin & 255 : M($30) = fin >> 8
    M($31) = fin & 255 : M($32) = fin >> 8
    M($AE) = fin & 255 : M($AF) = fin >> 8
    If autorun : C64TypeText(?TextRun) : EndIf
  EndIf
EndProcedure

; Queue a .PRG to go in once BASIC is up (about 3 seconds after power-on).
Procedure C64QueuePrg(prg.i, size.i, autorun.i)
  PrgPending = prg : PrgPendingSize = size : PrgAutoRun = autorun
  PrgFrame = C64Frame + 1
  If C64Frame < 150 : PrgFrame = 150 : EndIf
EndProcedure

Procedure C64InsertD64(image.i, size.i)
  D64Image = image : D64Size = size
  D64Inserted = Bool(image <> 0 And size >= 174848)
EndProcedure

; The offset of track t (1-35), sector s in a .D64, or -1.
Procedure.i D64Offset(trk.i, sec.i)
  Protected before.i
  If trk < 1 Or trk > 35 : ProcedureReturn -1 : EndIf
  If trk <= 17
    before = (trk - 1) * 21
    If sec > 20 : ProcedureReturn -1 : EndIf
  ElseIf trk <= 24
    before = 357 + (trk - 18) * 19
    If sec > 18 : ProcedureReturn -1 : EndIf
  ElseIf trk <= 30
    before = 490 + (trk - 25) * 18
    If sec > 17 : ProcedureReturn -1 : EndIf
  Else
    before = 598 + (trk - 31) * 17
    If sec > 16 : ProcedureReturn -1 : EndIf
  EndIf
  ProcedureReturn (before + sec) * 256
EndProcedure

; Does the directory entry at e match LoadName ('*' ends a pattern, '?' any)?
Procedure.i D64Match(e.i)
  Protected i.i, c.i, n.i
  For i = 0 To 15
    n = PeekA(e + 5 + i)
    If i >= LoadNameLen
      If n = $A0 : ProcedureReturn 1 : EndIf
      ProcedureReturn 0
    EndIf
    c = LoadName(i)
    If c = 42 : ProcedureReturn 1 : EndIf
    If c <> 63 And c <> n : ProcedureReturn 0 : EndIf
  Next
  ProcedureReturn Bool(LoadNameLen <= 16)
EndProcedure

; The directory entry (address in the image) of the first PRG matching LoadName.
Procedure.i D64Find()
  Protected trk.i, sec.i, off.i, i.i, e.i, guard.i
  trk = 18 : sec = 1
  While trk <> 0 And guard < 20
    off = D64Offset(trk, sec)
    If off < 0 : ProcedureReturn 0 : EndIf
    For i = 0 To 7
      e = D64Image + off + i * 32
      If (PeekA(e + 2) & 7) <> 0 And (PeekA(e + 2) & $80) <> 0
        If D64Match(e) : ProcedureReturn e : EndIf
      EndIf
    Next
    trk = PeekA(D64Image + off) : sec = PeekA(D64Image + off + 1)
    guard = guard + 1
  Wend
  ProcedureReturn 0
EndProcedure

Procedure.i LoadPut(adr.i, v.i)
  M(adr & $FFFF) = v
  ProcedureReturn (adr + 1) & $FFFF
EndProcedure

; The directory as the BASIC program LOAD"$",8 gives: a line per file, its
; number the file's blocks.
Procedure.i D64Directory(dest.i)
  Protected p.i, trk.i, sec.i, off.i, i.i, j.i, e.i, line.i, blocks.i, bam.i, free.i, c.i, guard.i
  bam = D64Image + D64Offset(18, 0)
  p = dest
  line = p : p = LoadPut(p, 1) : p = LoadPut(p, 1) : p = LoadPut(p, 0) : p = LoadPut(p, 0)
  p = LoadPut(p, $12) : p = LoadPut(p, 34)
  For i = 0 To 15
    c = PeekA(bam + $90 + i)
    If c = $A0 : c = 32 : EndIf
    p = LoadPut(p, c)
  Next
  p = LoadPut(p, 34) : p = LoadPut(p, 32)
  p = LoadPut(p, PeekA(bam + $A2)) : p = LoadPut(p, PeekA(bam + $A3)) : p = LoadPut(p, 32)
  p = LoadPut(p, PeekA(bam + $A5)) : p = LoadPut(p, PeekA(bam + $A6)) : p = LoadPut(p, 0)
  M(line) = p & 255 : M((line + 1) & $FFFF) = p >> 8
  trk = 18 : sec = 1
  While trk <> 0 And guard < 20
    off = D64Offset(trk, sec)
    If off < 0 : Break : EndIf
    For i = 0 To 7
      e = D64Image + off + i * 32
      If PeekA(e + 2) <> 0
        blocks = PeekA(e + 30) | (PeekA(e + 31) << 8)
        line = p
        p = LoadPut(p, 1) : p = LoadPut(p, 1) : p = LoadPut(p, blocks & 255) : p = LoadPut(p, blocks >> 8)
        If blocks < 100 : p = LoadPut(p, 32) : EndIf
        If blocks < 10 : p = LoadPut(p, 32) : EndIf
        p = LoadPut(p, 34)
        j = 0
        While j < 16
          c = PeekA(e + 5 + j)
          If c = $A0 : Break : EndIf
          p = LoadPut(p, c) : j = j + 1
        Wend
        p = LoadPut(p, 34)
        While j < 16 : p = LoadPut(p, 32) : j = j + 1 : Wend
        c = PeekA(e + 2) & 7
        If c = 1
          p = LoadPut(p, 83) : p = LoadPut(p, 69) : p = LoadPut(p, 81)
        ElseIf c = 2
          p = LoadPut(p, 80) : p = LoadPut(p, 82) : p = LoadPut(p, 71)
        ElseIf c = 3
          p = LoadPut(p, 85) : p = LoadPut(p, 83) : p = LoadPut(p, 82)
        ElseIf c = 4
          p = LoadPut(p, 82) : p = LoadPut(p, 69) : p = LoadPut(p, 76)
        Else
          p = LoadPut(p, 68) : p = LoadPut(p, 69) : p = LoadPut(p, 76)
        EndIf
        p = LoadPut(p, 0)
        M(line) = p & 255 : M((line + 1) & $FFFF) = p >> 8
      EndIf
    Next
    trk = PeekA(D64Image + off) : sec = PeekA(D64Image + off + 1)
    guard = guard + 1
  Wend
  free = 0
  For i = 1 To 35
    If i <> 18 : free = free + PeekA(bam + i * 4) : EndIf
  Next
  line = p
  p = LoadPut(p, 1) : p = LoadPut(p, 1) : p = LoadPut(p, free & 255) : p = LoadPut(p, free >> 8)
  p = C64PutText(p, ?TextBlocksFree)
  p = LoadPut(p, 0)
  M(line) = p & 255 : M((line + 1) & $FFFF) = p >> 8
  p = LoadPut(p, 0) : p = LoadPut(p, 0)
  ProcedureReturn p
EndProcedure

Procedure.i C64PutText(p.i, text.i)
  Protected c.i
  c = PeekA(text)
  While c
    p = LoadPut(p, c)
    text = text + 1
    c = PeekA(text)
  Wend
  ProcedureReturn p
EndProcedure

; The KERNAL's LOAD, device 8, from the inserted .D64. Leaves the CPU as the
; KERNAL would: carry clear and X/Y = the end address, or carry set and A = 4
; (FILE NOT FOUND); then returns to LOAD's caller.
Procedure.i C64TrapLoad()
  Protected i.i, nameAdr.i, e.i, trk.i, sec.i, off.i, n.i, dest.i, adr.i, first.i, guard.i
  If M($BA) <> 8 Or D64Inserted = 0 Or A <> 0
    ; not ours: run the instruction the trap replaced (STA $93)
    M($93) = A
    PC = (#TRAP_LOAD + 2) & $FFFF
    ProcedureReturn 1
  EndIf
  M($93) = A
  LoadCount = LoadCount + 1
  nameAdr = M($BB) | (M($BC) << 8)
  LoadNameLen = M($B7)
  If LoadNameLen > 18 : LoadNameLen = 18 : EndIf
  n = 0
  For i = 0 To LoadNameLen - 1
    Pg = RdMap(((nameAdr + i) >> 8) & 255)
    If Pg : LoadName(n) = PeekA(Pg + ((nameAdr + i) & $FFFF)) : Else : LoadName(n) = M((nameAdr + i) & $FFFF) : EndIf
    n = n + 1
  Next
  ; "0:NAME" and ":NAME" name the same file
  If n >= 2 And LoadName(1) = 58
    For i = 0 To n - 3 : LoadName(i) = LoadName(i + 2) : Next
    n = n - 2
  ElseIf n >= 1 And LoadName(0) = 58
    For i = 0 To n - 2 : LoadName(i) = LoadName(i + 1) : Next
    n = n - 1
  EndIf
  LoadNameLen = n
  dest = M($C3) | (M($C4) << 8)
  If n = 1 And LoadName(0) = 36
    dest = M($2B) | (M($2C) << 8)
    If M($B9) <> 0 : dest = $0401 : EndIf
    adr = D64Directory(dest)
  Else
    If n = 0 : LoadName(0) = 42 : LoadNameLen = 1 : EndIf
    e = D64Find()
    If e = 0
      LoadError = LoadError + 1
      A = 4 : FC = $100
      CpuPop(Lo) : CpuPop(Hi) : PC = ((Lo | (Hi << 8)) + 1) & $FFFF
      ProcedureReturn 1
    EndIf
    trk = PeekA(e + 3) : sec = PeekA(e + 4)
    first = 1 : adr = dest
    While trk <> 0 And guard < 800
      off = D64Offset(trk, sec)
      If off < 0 : Break : EndIf
      off = D64Image + off
      n = 255
      If PeekA(off) = 0 : n = PeekA(off + 1) : EndIf
      i = 2
      If first
        If M($B9) <> 0 : adr = PeekA(off + 2) | (PeekA(off + 3) << 8) : EndIf
        first = 0 : i = 4
      EndIf
      While i <= n
        adr = LoadPut(adr, PeekA(off + i))
        i = i + 1
      Wend
      trk = PeekA(off) : sec = PeekA(off + 1)
      guard = guard + 1
    Wend
  EndIf
  LoadLastEnd = adr
  M($AE) = adr & 255 : M($AF) = adr >> 8
  X = adr & 255 : Y = adr >> 8
  M($90) = $40
  FC = 0
  CpuPop(Lo) : CpuPop(Hi) : PC = ((Lo | (Hi << 8)) + 1) & $FFFF
  ProcedureReturn 1
EndProcedure

Procedure.i C64Trap(addr.i)
  If BenchMode : ProcedureReturn BenchTrap(addr) : EndIf
  If addr = #TRAP_LOAD And LoadTrapOn : ProcedureReturn C64TrapLoad() : EndIf
  ProcedureReturn 0
EndProcedure

DataSection
TextRun:
  Data.a 82, 85, 78, 13, 0
TextBlocksFree:
  Data.a 66, 76, 79, 67, 75, 83, 32, 70, 82, 69, 69, 46, 0
EndDataSection
