; PureMetal C64 for the desktop: the same machine as the boards (desktop/core, ported from src/ by
; tools/port_desktop.py; the 6510 generated by tools/gen_cpu.py), drawn with the Neon Arcade Display Engine.
;
; Build (PowerShell, from the repository root):
;   & "C:\Program Files\PureBasic\Compilers\pbcompilerc.exe" desktop\c64_desktop.pb /EXE desktop\PureMetalC64.exe /THREAD /DPIAWARE /OPTIMIZER
;   (the Neon Arcade Display Engine, https://github.com/ajtaji/Neon-Arcade-Dispay-Engine, is found
;    cloned beside this repository - <parent>/Neon-Arcade-Dispay-Engine/ - unless
;    /CONSTANT GL_ENGINE_DIR$=<path>/ says otherwise; the trailing slash matters)
; Run:  desktop\PureMetalC64.exe [program.prg|disk.d64] [--roms folder] [--ntsc] [--mute] [--tab N] [--shot window.png --seconds S]
;
; The ROMs (BASIC, KERNAL, character ROM) are not included: choose their folder once (Tools tab / the
; toolbar's ROMs button); it is remembered. Without them the built-in demo runs.
; Keys: the PC keyboard is the C64's (see keyboard.pbi). Joystick: arrows + Right Ctrl, port 2 (toolbar).
;       F5 run/pause, F6 step one instruction, F7 step one frame, F8 reset, F11 full screen; Page Up is RESTORE.
EnableExplicit

CompilerIf Not Defined(GL_ENGINE_DIR$, #PB_Constant)
  #GL_ENGINE_DIR$ = #PB_Compiler_FilePath + "../../Neon-Arcade-Dispay-Engine/"
CompilerEndIf
XIncludeFile #GL_ENGINE_DIR$ + "GlTypes.pbi"
XIncludeFile #GL_ENGINE_DIR$ + "GlUtilities.pbi"
XIncludeFile #GL_ENGINE_DIR$ + "GlMath.pbi"
XIncludeFile #GL_ENGINE_DIR$ + "GlSpriteFunctions.pbi"
XIncludeFile #GL_ENGINE_DIR$ + "GlUI.pbi"
XIncludeFile #GL_ENGINE_DIR$ + "GlUIChrome.pbi"
; this frame is not drawn through DrawRetroCRT: with the CRT on (the engine's default) every pointer
; position is bent by its barrel curve - up to 28 px at 125%, worst at the top and bottom of the window
UI_UseCRT = #False
CompilerIf Defined(PLANT_CRT, #PB_Constant)
  UI_UseCRT = #True   ; only to see --pointer-test fail
CompilerEndIf

XIncludeFile "core/machine.pbi"
XIncludeFile "sound.pbi"
XIncludeFile "keyboard.pbi"
XIncludeFile "view.pbi"

; ---------------------------------------------------------------- state
Global Win.i, Gl.i, PhysW.i, PhysH.i
Global Quit.i, Paused.i
Global KeyCode.i, KeyChar.i, Wheel.i
Global PadCount.i
Global EmuAccum.d, EmuLastUs.q, EmuFrameUs.d = 1000000.0 * 19656 / 985248
Global FpsShown.d, FpsFrames.i, FpsSince.q, IpsShown.i, IpsInstr.i, EmuUsShown.d, EmuUsSum.q
Global ActiveTab.i, StatusLine$, RomDir$, Prefs$, WantPal.i = 0
Global *RomBasic, *RomKernal, *RomChar, *Program, ProgramSize.i, *Disk, DiskSize.i, ProgramKind$
Global LastDraw.q, ShotFile$, ShotAtMs.q, GlCurrent.i
Global TestDir$ = GetPathPart(ProgramFilename()) + "..\tests\lorenz\"
Global *BenchRec, BenchLine$

; The host's clock in microseconds.
Global HostTimerFreq.q, HostTimerStart.q
Procedure.q ElapsedMicroseconds()
  Protected now.q
  CompilerIf #PB_Compiler_OS = #PB_OS_Windows
    If HostTimerFreq = 0 : QueryPerformanceFrequency_(@HostTimerFreq) : QueryPerformanceCounter_(@HostTimerStart) : EndIf
    QueryPerformanceCounter_(@now)
    ProcedureReturn ((now - HostTimerStart) * 1000000) / HostTimerFreq
  CompilerElse
    ProcedureReturn ElapsedMilliseconds() * 1000
  CompilerEndIf
EndProcedure

; ---------------------------------------------------------------- the platform side of the machine
Procedure.i PlatformLine(viewY.i)
  ProcedureReturn @ScreenFrame(viewY * 384)
EndProcedure
Procedure PlatformLineDone(viewY.i)
EndProcedure
; one thread: a line's record is drawn as soon as it is made
Procedure PlatformRecord()
  VicRenderNext()
EndProcedure
Procedure PlatformRecordWait()
EndProcedure
Procedure PlatformFence()
EndProcedure
Procedure.i PlatformUs()
  ProcedureReturn 0
EndProcedure
Procedure PlatformFrameDone()
EndProcedure
Procedure PlatformTick()
EndProcedure

Procedure.i BenchFile(nameAdr.i, n.i)
  Protected name$, f.i, size.i, i.i
  For i = 0 To n - 1 : name$ + Chr(PeekA(nameAdr + i)) : Next
  If name$ = "" Or name$ = "trap17x" : ProcedureReturn 0 : EndIf
  ; the CPU tests end where the chain asks for the CIA tests (mmufetch needs the real ROMs)
  If name$ = "mmufetch" : ProcedureReturn 0 : EndIf
  f = ReadFile(#PB_Any, TestDir$ + name$)
  If f = 0 : ProcedureReturn 0 : EndIf
  size = Lof(f)
  If *BenchRec : FreeMemory(*BenchRec) : EndIf
  *BenchRec = AllocateMemory(size + n + 3)
  PokeA(*BenchRec, n)
  For i = 0 To n - 1 : PokeA(*BenchRec + 1 + i, PeekA(nameAdr + i)) : Next
  PokeA(*BenchRec + 1 + n, size & 255) : PokeA(*BenchRec + 2 + n, size >> 8)
  ReadData(f, *BenchRec + 3 + n, size)
  CloseFile(f)
  ProcedureReturn *BenchRec
EndProcedure
Procedure BenchPrint(c.i)
  If c = 13
    If FindString(BenchLine$, "before") Or FindString(BenchLine$, "after") Or FindString(BenchLine$, "right")
      ViewTestLog$ + BenchLine$ + #LF$
    EndIf
    BenchLine$ = ""
  ElseIf c >= 65 And c <= 90
    BenchLine$ + Chr(c + 32)
  ElseIf c >= 193 And c <= 218
    BenchLine$ + Chr(c - 128)
  ElseIf c >= 32 And c < 127
    BenchLine$ + Chr(c)
  EndIf
EndProcedure
Procedure BenchEvent(kind.i, rec.i)
  Protected i.i, n$
  If kind = 3
    For i = 1 To PeekA(rec) : n$ + Chr(PeekA(rec + i)) : Next
    ViewTestLog$ + "FAILED: " + n$ + #LF$
  EndIf
EndProcedure

; ---------------------------------------------------------------- files and ROMs
Procedure.i ReadWhole(path$, *size.Integer)
  Protected f.i, *m
  f = ReadFile(#PB_Any, path$)
  If f = 0 : ProcedureReturn 0 : EndIf
  *size\i = Lof(f)
  *m = AllocateMemory(*size\i + 16)
  ReadData(f, *m, *size\i) : CloseFile(f)
  ProcedureReturn *m
EndProcedure

; A ROM folder: the three files found by size and by a name that says what they are.
Procedure.i FindRoms(dir$)
  Protected d.i, n$, size.i, *m, ok.i
  If dir$ = "" : ProcedureReturn 0 : EndIf
  If Right(dir$, 1) <> "\" And Right(dir$, 1) <> "/" : dir$ + "\" : EndIf
  d = ExamineDirectory(#PB_Any, dir$, "*.*")
  If d = 0 : ProcedureReturn 0 : EndIf
  While NextDirectoryEntry(d)
    If DirectoryEntryType(d) = #PB_DirectoryEntry_File
      n$ = LCase(DirectoryEntryName(d)) : size = DirectoryEntrySize(d)
      If size = 8192 And FindString(n$, "basic") : *RomBasic = ReadWhole(dir$ + DirectoryEntryName(d), @size) : EndIf
      If size = 8192 And FindString(n$, "kernal") : *RomKernal = ReadWhole(dir$ + DirectoryEntryName(d), @size) : EndIf
      If size = 4096 And (FindString(n$, "char") Or FindString(n$, "901225")) : *RomChar = ReadWhole(dir$ + DirectoryEntryName(d), @size) : EndIf
    EndIf
  Wend
  FinishDirectory(d)
  If *RomBasic And *RomKernal And *RomChar
    RomDir$ = dir$
    If CreatePreferences(Prefs$) : WritePreferenceString("roms", RomDir$) : WritePreferenceString("folder", ViewFolder$) : ClosePreferences() : EndIf
    ProcedureReturn 1
  EndIf
  ProcedureReturn 0
EndProcedure

; Power on: the real machine with ROMs, else the built-in demo. Then the program or disk, if any.
Procedure MachineStart()
  Protected size.i, *demo
  BenchMode = 0
  C64SetStandard(WantPal)
  EmuFrameUs = 1000000.0 * C64Lines * C64CyclesPerLine / C64Hz
  If *RomBasic And *RomKernal And *RomChar
    C64SetRoms(*RomBasic, *RomKernal, *RomChar)
    C64PowerOn()
    C64Frame = 0
    C64InsertD64(*Disk, DiskSize)
    StatusLine$ = "BASIC  (ROMs: " + RomDir$ + ")"
    If ProgramKind$ = "prg"
      C64QueuePrg(*Program, ProgramSize, 1)
      StatusLine$ = GetFilePart(ViewCurrent$) + "  (.PRG, put in and RUN)"
    ElseIf ProgramKind$ = "d64"
      C64TypeText(?TextLoadRun)
      StatusLine$ = GetFilePart(ViewCurrent$) + "  (.D64 in drive 8: LOAD" + Chr(34) + "*" + Chr(34) + ",8,1 and RUN)"
    EndIf
  Else
    *demo = ReadWhole(GetPathPart(ProgramFilename()) + "..\tests\demo.prg", @size)
    BenchRoms() : BenchMode = 0
    C64PowerOn()
    If *demo : C64InjectPrg(*demo, size, 0) : PC = $C000 : EndIf
    StatusLine$ = "No ROMs chosen: the built-in demo (toolbar: ROMs...)"
  EndIf
  SoundReset()
  EmuAccum = 0 : EmuLastUs = ElapsedMicroseconds()
EndProcedure

Procedure OpenProgram(path$)
  Protected ext$ = LCase(GetExtensionPart(path$)), *m, size.i
  *m = ReadWhole(path$, @size)
  If *m = 0 : StatusLine$ = "Cannot open " + path$ : ProcedureReturn : EndIf
  ViewCurrent$ = path$
  If ViewFolder$ <> GetPathPart(path$) : ViewFilesRefresh(GetPathPart(path$)) : EndIf
  If ext$ = "d64"
    *Disk = *m : DiskSize = size : ProgramKind$ = "d64"
  Else
    *Program = *m : ProgramSize = size : ProgramKind$ = "prg"
  EndIf
  MachineStart()
  Paused = 0
EndProcedure

; A disk into drive 8 while the machine runs (a game's second disk): no reset.
Procedure InsertDisk(path$)
  Protected *m, size.i
  *m = ReadWhole(path$, @size)
  If *m = 0 : StatusLine$ = "Cannot open " + path$ : ProcedureReturn : EndIf
  *Disk = *m : DiskSize = size
  C64InsertD64(*Disk, DiskSize)
  StatusLine$ = GetFilePart(path$) + " is in drive 8"
EndProcedure

Procedure ViewRunTests()
  Protected t.q = ElapsedMilliseconds(), first$ = " start", *nm, frames.i
  ViewTestLog$ = "" : BenchFailures = 0 : BenchTests = 0 : BenchFinished = 0
  *nm = AllocateMemory(64) : PokeS(*nm, first$, -1, #PB_Ascii)
  BenchStart(*nm, Len(first$))
  While Stopped = 0 And frames < 400000
    C64RunFrame() : frames + 1
  Wend
  If BenchFinished = 0 : BenchFailures + 1 : ViewTestLog$ + "CPU STOPPED at $" + Hex4(PC) + #LF$ : EndIf
  ViewTestFailed = Bool(BenchFailures <> 0)
  ViewTestResult$ = Str(BenchTests) + " tests, " + Str(BenchFailures) + " failures: " + StringField("PASS|FAIL", 1 + ViewTestFailed, "|") + "  (" + Str(ElapsedMilliseconds() - t) + " ms, " + Str(frames) + " frames)"
  FreeMemory(*nm)
  MachineStart()
EndProcedure

; ---------------------------------------------------------------- fonts and size
; The fonts at their logical size * the display scale (Neon_UIScale), rebuilt when the scale changes.
Global FontsBuilt.i
Procedure BuildFonts()
  If FontsBuilt
    FreeGLFont(*Neon_FontUI) : FreeGLFont(*Neon_FontSmall) : FreeGLFont(*Neon_FontBold) : FreeGLFont(*Neon_FontMono)
  EndIf
  FontsBuilt = 1
  *Neon_FontUI = Neon_CreateFontPx("Segoe UI", Round(Neon_S(14), #PB_Round_Nearest))
  *Neon_FontSmall = Neon_CreateFontPx("Segoe UI", Round(Neon_S(12), #PB_Round_Nearest))
  *Neon_FontBold = Neon_CreateFontPx("Segoe UI", Round(Neon_S(15), #PB_Round_Nearest), #PB_Font_Bold)
  *Neon_FontMono = Neon_CreateFontPx("Consolas", Round(Neon_S(13), #PB_Round_Nearest))
  GLFontSetSnapToPixel(*Neon_FontUI, #True) : GLFontSetSnapToPixel(*Neon_FontSmall, #True)
  GLFontSetSnapToPixel(*Neon_FontBold, #True) : GLFontSetSnapToPixel(*Neon_FontMono, #True)
EndProcedure

Procedure MeasureWindow()
  CompilerIf #PB_Compiler_OS = #PB_OS_Windows
    Protected client.RECT
    GetClientRect_(WindowID(Win), @client)
    PhysW = client\right - client\left : PhysH = client\bottom - client\top
  CompilerElse
    PhysW = WindowWidth(Win, #PB_Window_InnerCoordinate) * Linux_DPIScale
    PhysH = WindowHeight(Win, #PB_Window_InnerCoordinate) * Linux_DPIScale
  CompilerEndIf
  If PhysW < 1 : PhysW = 1 : EndIf
  If PhysH < 1 : PhysH = 1 : EndIf
  ResizeGadget(Gl, 0, 0, WindowWidth(Win, #PB_Window_InnerCoordinate), WindowHeight(Win, #PB_Window_InnerCoordinate))
  GL_ViewportX = 0 : GL_ViewportY = 0 : GL_ViewportW = PhysW : GL_ViewportH = PhysH
  Util_BaseWidth = PhysW : Util_BaseHeight = PhysH
  Util_WinWidth = WindowWidth(Win, #PB_Window_InnerCoordinate) : Util_WinHeight = WindowHeight(Win, #PB_Window_InnerCoordinate)
  ; the display scale s = physical / logical client width, MEASURED (the engine's GlUIChrome.pbi section 5a):
  ; the chrome (Neon_UIScale) and the fonts follow it, and change with it on a monitor with another scale
  Protected s.f = 1.0
  If Util_WinWidth > 0 : s = PhysW / Util_WinWidth : EndIf
  If s <= 0 : s = 1.0 : EndIf
  If FontsBuilt = 0 Or Abs(s - Neon_UIScale) > 0.005 : Neon_UIScale = s : BuildFonts() : EndIf
EndProcedure

; ---------------------------------------------------------------- running
Procedure ReadControls()
  Protected joy.i, active.i, ax.i, ay.i
  CompilerIf #PB_Compiler_OS = #PB_OS_Windows
    active = Bool(GetActiveWindow() = Win)
  CompilerEndIf
  joy = KbApply(active)
  If PadCount > 0 And ExamineJoystick(0)
    ax = JoystickAxisX(0) : ay = JoystickAxisY(0)
    If ax < 0 : joy | 4 : ElseIf ax > 0 : joy | 8 : EndIf
    If ay < 0 : joy | 1 : ElseIf ay > 0 : joy | 2 : EndIf
    If JoystickButton(0, 1) Or JoystickButton(0, 2) : joy | 16 : EndIf
  EndIf
  If KbJoyPort = 2 : Joy2 = joy : Joy1 = 0 : Else : Joy1 = joy : Joy2 = 0 : EndIf
  If KbRestoreHeld <> C64Restore : C64Restore = KbRestoreHeld : C64UpdateIrq(C64Clock) : EndIf
EndProcedure

Procedure RunOneFrame()
  Protected t.q = ElapsedMicroseconds()
  ReadControls()
  C64LoaderFrame()
  C64RunFrame()
  EmuUsSum + ElapsedMicroseconds() - t
  FpsFrames + 1
EndProcedure

; Whole frames to keep pace with real time (50.12 Hz PAL, 59.83 Hz NTSC); at most three per pass.
Procedure Emulate()
  Protected now.q, n.i
  now = ElapsedMicroseconds()
  If EmuLastUs = 0 : EmuLastUs = now : EndIf
  If Paused : EmuLastUs = now : ProcedureReturn : EndIf
  EmuAccum + (now - EmuLastUs) : EmuLastUs = now
  If EmuAccum > EmuFrameUs * 4 : EmuAccum = EmuFrameUs * 4 : EndIf
  While EmuAccum >= EmuFrameUs And n < 3
    RunOneFrame() : EmuAccum - EmuFrameUs : n + 1
  Wend
  ; keep the sound card fed: one more frame when its queue runs low
  If SoundOn And SoundPump() < #SOUND_SAMPLES And n < 3 And SoundAvailable() < #SOUND_SAMPLES
    RunOneFrame() : EmuAccum - EmuFrameUs
  EndIf
EndProcedure

Procedure StepInstruction()
  Paused = 1
  C64Clock + CpuRun(1)
EndProcedure
Procedure StepFrame()
  Paused = 1 : RunOneFrame()
EndProcedure

Procedure SaveWindowShot(file$)
  Protected *buf = AllocateMemory(PhysW * PhysH * 4), img.i, x.i, y.i, c.l
  glReadPixels_(0, 0, PhysW, PhysH, #GL_RGBA, #GL_UNSIGNED_BYTE, *buf)
  img = CreateImage(#PB_Any, PhysW, PhysH, 24)
  StartDrawing(ImageOutput(img))
  For y = 0 To PhysH - 1
    For x = 0 To PhysW - 1
      c = PeekL(*buf + ((PhysH - 1 - y) * PhysW + x) * 4)
      Plot(x, y, RGB(c & 255, (c >> 8) & 255, (c >> 16) & 255))
    Next
  Next
  StopDrawing()
  UsePNGImageEncoder()
  SaveImage(img, file$, #PB_ImagePlugin_PNG)
  FreeImage(img) : FreeMemory(*buf)
EndProcedure

; ---------------------------------------------------------------- one frame of the window


; ---------------------------------------------------------------- full screen
; The Full screen button or F11: a borderless window over the monitor the window is on (no display-mode
; change) showing only the C64's picture, border included, at its real pixel aspect - PAL pixels are
; 0.9365 as wide as they are high, NTSC 0.75 - as large as fits and centred, black around it. Emulation,
; sound and the frame rate are the window's. Esc leaves (and is not the C64's RUN/STOP there: End is), and
; the window comes back exactly as it was. The pointer hides after two idle seconds.
Global FullScreen.i, FsStyle.i, FsPlacement.WINDOWPLACEMENT, FsCursorHidden.i, FsMouseX.i, FsMouseY.i, FsMouseMs.q
Global FsViewX.f, FsViewY.f, FsViewW.f, FsViewH.f

Procedure FsShowCursor(show.i)
  If show And FsCursorHidden : ShowCursor_(#True) : FsCursorHidden = 0 : EndIf
  If show = 0 And FsCursorHidden = 0 : ShowCursor_(#False) : FsCursorHidden = 1 : EndIf
EndProcedure

Procedure EnterFullScreen()
  Protected hwnd.i = WindowID(Win), mi.MONITORINFO
  If FullScreen : ProcedureReturn : EndIf
  FsPlacement\length = SizeOf(WINDOWPLACEMENT) : GetWindowPlacement_(hwnd, @FsPlacement)
  FsStyle = GetWindowLongPtr_(hwnd, #GWL_STYLE)
  mi\cbSize = SizeOf(MONITORINFO) : GetMonitorInfo_(MonitorFromWindow_(hwnd, 2), @mi)   ; 2: the nearest monitor
  SetWindowLongPtr_(hwnd, #GWL_STYLE, FsStyle & ~(#WS_CAPTION | #WS_THICKFRAME | #WS_MINIMIZEBOX | #WS_MAXIMIZEBOX | #WS_SYSMENU))
  SetWindowPos_(hwnd, #HWND_TOP, mi\rcMonitor\left, mi\rcMonitor\top, mi\rcMonitor\right - mi\rcMonitor\left, mi\rcMonitor\bottom - mi\rcMonitor\top, #SWP_FRAMECHANGED | #SWP_NOOWNERZORDER | #SWP_SHOWWINDOW)
  FullScreen = 1 : KbNoEsc = 1 : FsMouseMs = ElapsedMilliseconds()
  MeasureWindow()
EndProcedure

Procedure LeaveFullScreen()
  Protected hwnd.i = WindowID(Win)
  If FullScreen = 0 : ProcedureReturn : EndIf
  SetWindowLongPtr_(hwnd, #GWL_STYLE, FsStyle)
  SetWindowPlacement_(hwnd, @FsPlacement)
  SetWindowPos_(hwnd, 0, 0, 0, 0, 0, #SWP_FRAMECHANGED | #SWP_NOMOVE | #SWP_NOSIZE | #SWP_NOZORDER | #SWP_NOOWNERZORDER)
  FullScreen = 0 : KbNoEsc = 0 : FsShowCursor(1)
  MeasureWindow()
EndProcedure

; The picture's real width / height: 384 columns of the standard's pixel aspect over its rows.
Procedure.f FsAspect()
  Protected par.f = 0.9365
  If C64Pal = 0 : par = 0.75 : EndIf
  ProcedureReturn 384 * par / VicViewH
EndProcedure

Procedure DrawFullScreen(pw.f, ph.f)
  Protected a.f = FsAspect(), vw.f, vh.f, mx.i, my.i
  vw = pw : vh = vw / a
  If vh > ph : vh = ph : vw = vh * a : EndIf
  vw = Round(vw, #PB_Round_Nearest) : vh = Round(vh, #PB_Round_Nearest)
  FsViewW = vw : FsViewH = vh : FsViewX = Round((pw - vw) / 2, #PB_Round_Down) : FsViewY = Round((ph - vh) / 2, #PB_Round_Down)
  Neon_Box(0, 0, pw, ph, 0, 0, 0)
  ViewDrawScreenAt(FsViewX, FsViewY, FsViewW, FsViewH)
  ; the pointer hides after two seconds without moving, and shows again when it moves
  mx = WindowMouseX(Win) : my = WindowMouseY(Win)
  If mx <> FsMouseX Or my <> FsMouseY : FsMouseX = mx : FsMouseY = my : FsMouseMs = ElapsedMilliseconds() : FsShowCursor(1) : EndIf
  If ElapsedMilliseconds() - FsMouseMs > 2000 : FsShowCursor(0) : EndIf
EndProcedure

; The window's own keys, from the controls table (controls.pbi): F5 F6 F7 F8, F11, and Esc in full screen.
Procedure WindowAction(act.i)
  Select act
    Case #ACT_RUNPAUSE : Paused = 1 - Paused : EmuLastUs = ElapsedMicroseconds()
    Case #ACT_STEP : StepInstruction()
    Case #ACT_FRAME : StepFrame()
    Case #ACT_RESET : MachineStart()
    Case #ACT_FULLSCREEN : If FullScreen : LeaveFullScreen() : Else : EnterFullScreen() : EndIf
    Case #ACT_LEAVEFULL : LeaveFullScreen()
  EndSelect
EndProcedure

; ---------------------------------------------------------------- --pointer-test
; The real pointer is shared with everyone on this desktop, so it is never moved: the chrome is driven with
; synthetic positions in the units WindowMouseX/Y give a DPI-aware window (physical pixels), through the same
; Neon_ChromeBeginFrame call. For every control four points: just inside its top-left and its bottom-right
; corner (a press must land on it), just right of it and just below it (a press must not). Every frame
; Neon_MX / Neon_MY must read the point back unbent. Controls at the top of the window (the toolbar, the tab
; strip), in the middle (the memory pane's buttons) and at the bottom (the program list's last row).
Global PtLog$, PtFile$, PtX.f, PtY.f, PtDown.i, PtCase.i, PtPoint.i, PtFrame.i, PtFails.i, PtPoints.i, PtWorst.f, PtDone.i
Global PtCount.i, Dim PtName$(40)

Procedure PtInit()
  Protected n$ = "Open|ROMs|Pause|Step|Frame|Reset|Mute|Standard|Joy keys|Full screen|tab 0|tab 2|tab 5|tab 6|mem back|mem PC|Run tests|Open file|Swap disk|list first row|list last row"
  Protected i.i
  PtCount = CountString(n$, "|") + 1
  For i = 0 To PtCount - 1 : PtName$(i) = StringField(n$, i + 1, "|") : Next
  ClearList(ViewFiles())
  For i = 1 To 400 : AddElement(ViewFiles()) : ViewFiles() = "program " + Str(i) + ".prg" : Next   ; longer than its pane
  ViewFilesTop = 0
EndProcedure

; The page a control is drawn on.
Procedure.i PtPage(name$)
  If Left(name$, 4) = "mem " : ProcedureReturn 0 : EndIf
  If name$ = "Run tests" : ProcedureReturn 4 : EndIf
  If name$ = "Open file" Or name$ = "Swap disk" Or Left(name$, 5) = "list " : ProcedureReturn 5 : EndIf
  ProcedureReturn 0
EndProcedure

Procedure.i PtRect(name$, *r.CtlRect)
  Protected *row.Neon_TabRowLayout, i.i
  If Left(name$, 4) = "tab "
    If FindMapElement(Neon_TabLayout(), "1") = 0 : ProcedureReturn 0 : EndIf
    *row = @Neon_TabLayout() : i = Val(Mid(name$, 5))
    If i >= *row\Count : ProcedureReturn 0 : EndIf
    ; the row's last pixel is the strip's underline, not a tab
    *r\x = *row\X(i) : *r\w = *row\W(i) : *r\y = *row\Y : *r\h = *row\H - 1
    ProcedureReturn 1
  EndIf
  If FindMapElement(Ctl(), name$) = 0 : ProcedureReturn 0 : EndIf
  CopyStructure(@Ctl(), *r, CtlRect)
  ProcedureReturn 1
EndProcedure

; One step, after each frame is drawn.
Procedure PtStep()
  Protected r.CtlRect, name$, inside.i, got$, ok.i, f.i
  If PtCase >= PtCount
    PtLog$ + "pointer-test: " + Str(PtPoints) + " points on " + Str(PtCount) + " controls, " + Str(PtFails) + " failures, scale " +
             StrF(Neon_UIScale, 2) + ", canvas " + Str(Util_BaseWidth) + "x" + Str(Util_BaseHeight) + " physical, window " +
             Str(Util_WinWidth) + "x" + Str(Util_WinHeight) + " logical, UI_UseCRT " + Str(UI_UseCRT) +
             ", worst pointer read-back error " + StrF(PtWorst, 2) + " px" + #LF$
    f = CreateFile(#PB_Any, PtFile$)
    If f : WriteString(f, PtLog$) : CloseFile(f) : EndIf
    PtDone = 1
    ProcedureReturn
  EndIf
  name$ = PtName$(PtCase)
  If PtFrame > 1
    If Abs(Neon_MX - PtX) > PtWorst : PtWorst = Abs(Neon_MX - PtX) : EndIf
    If Abs(Neon_MY - PtY) > PtWorst : PtWorst = Abs(Neon_MY - PtY) : EndIf
  EndIf
  PtFrame + 1
  Select PtFrame
    Case 1                                       ; the page that shows the control, the pointer away
      ActiveTab = PtPage(name$)
      PtX = 1 : PtY = 1 : PtDown = 0
    Case 2                                       ; drawn: go to the point
      If PtRect(name$, @r) = 0
        PtLog$ + "FAIL " + name$ + ": not drawn" + #LF$ : PtFails + 1
        PtFrame = 0 : PtPoint = 0 : PtCase + 1 : ProcedureReturn
      EndIf
      Select PtPoint
        Case 0 : PtX = r\x + 2 : PtY = r\y + 2
        Case 1 : PtX = r\x + r\w - 2 : PtY = r\y + r\h - 2
        Case 2 : PtX = r\x + r\w + 2 : PtY = r\y + r\h - 2
        Case 3 : PtX = r\x + r\w - 2 : PtY = r\y + r\h + 2
      EndSelect
      PtClicked$ = ""
      If Left(name$, 4) = "tab " : ActiveTab = 99 : EndIf   ; no tab selected: a press shows as the new value
    Case 3 : PtDown = 1                          ; press
    Case 4 : PtDown = 0                          ; release
    Case 6                                       ; what the press did
      PtRect(name$, @r)
      inside = Bool(PtPoint < 2)
      If Left(name$, 4) = "tab "
        got$ = "tab " + Str(ActiveTab)
        ok = Bool((got$ = name$) = inside)
      Else
        got$ = PtClicked$
        If got$ = "" : got$ = "nothing" : EndIf
        ok = Bool((PtClicked$ = name$) = inside)
      EndIf
      PtPoints + 1
      PtLog$ + StringField("FAIL|ok", 1 + ok, "|") + "  " + LSet(name$, 16) + " rect (" + StrF(r\x, 1) + "," + StrF(r\y, 1) + " " +
               StrF(r\w, 1) + "x" + StrF(r\h, 1) + ")  point (" + StrF(PtX, 0) + "," + StrF(PtY, 0) + ") " +
               StringField("outside|inside", 1 + inside, "|") + "  read back (" + StrF(Neon_MX, 1) + "," + StrF(Neon_MY, 1) + ")  press -> " + got$ + #LF$
      If ok = 0 : PtFails + 1 : EndIf
      If Left(name$, 4) = "tab " : ActiveTab = 0 : EndIf
      PtPoint + 1 : PtFrame = 0
      If PtPoint = 4 : PtPoint = 0 : PtCase + 1 : EndIf
  EndSelect
EndProcedure


; ---------------------------------------------------------------- --fullscreen-test
; Full screen by its own keys, no real pointer or keyboard: F11 and Esc are posted to the window's GL gadget
; (as the keyboard would send them), and the keys the C64 sees are checked through this thread's own
; keyboard state (SetKeyboardState, which no other program reads). Checked: Esc in the window is RUN/STOP and
; leaves the window alone; F11 covers the window's monitor, the picture has the standard's real shape, fits
; and is centred, the machine runs on, Esc is not RUN/STOP there (End is), the scale is measured again; Esc
; leaves and the window's rectangle and style come back exactly; then the same in PAL.
Global FtOn.i, FtFile$, FtShot$, FtStep.i, FtWait.i, FtFails.i, FtLog$, FtDone.i, FtRect.RECT, FtStyle.i, FtFrame.i, FtMs.q
Global Dim FtKeys.a(255)

Procedure FtCheck(ok.i, what$)
  If ok = 0 : FtFails + 1 : FtLog$ + "FAIL " : Else : FtLog$ + "ok   " : EndIf
  FtLog$ + what$ + #LF$
EndProcedure
Procedure FtKey(vk.i)
  PostMessage_(GadgetID(Gl), #WM_KEYDOWN, vk, 0) : PostMessage_(GadgetID(Gl), #WM_KEYUP, vk, 0)
EndProcedure
; The C64's RUN/STOP (matrix column 7, row 7) with only this key down, through this thread's keyboard state.
Procedure.i FtRunStopWith(vk.i)
  Protected i.i, r.i
  For i = 0 To 255 : FtKeys(i) = 0 : Next
  FtKeys(vk) = $80
  SetKeyboardState_(@FtKeys(0))
  KbApply(1)
  r = Bool(KeyRows(7) & $80)
  FtKeys(vk) = 0 : SetKeyboardState_(@FtKeys(0))
  ProcedureReturn r
EndProcedure

Procedure FtFull(std$)
  Protected r.RECT, mi.MONITORINFO, hwnd.i = WindowID(Win), a.f = FsAspect()
  GetWindowRect_(hwnd, @r) : mi\cbSize = SizeOf(MONITORINFO) : GetMonitorInfo_(MonitorFromWindow_(hwnd, 2), @mi)
  FtCheck(FullScreen, std$ + ": F11 entered full screen")
  FtCheck(Bool(r\left = mi\rcMonitor\left And r\top = mi\rcMonitor\top And r\right = mi\rcMonitor\right And r\bottom = mi\rcMonitor\bottom),
          std$ + ": the window covers its monitor (" + Str(r\left) + "," + Str(r\top) + " - " + Str(r\right) + "," + Str(r\bottom) + "; monitor " +
          Str(mi\rcMonitor\left) + "," + Str(mi\rcMonitor\top) + " - " + Str(mi\rcMonitor\right) + "," + Str(mi\rcMonitor\bottom) + ")")
  FtCheck(Bool(Abs(FsViewW / FsViewH - a) < 0.005), std$ + ": the picture " + StrF(FsViewW, 0) + "x" + StrF(FsViewH, 0) + " has the standard's shape " + StrF(FsViewW / FsViewH, 4) + " (" + StrF(a, 4) + ": 384 x the pixel aspect / " + Str(VicViewH) + " rows)")
  FtCheck(Bool(FsViewW <= PhysW And FsViewH <= PhysH And (Abs(FsViewW - PhysW) <= 1 Or Abs(FsViewH - PhysH) <= 1)), std$ + ": as large as fits in " + Str(PhysW) + "x" + Str(PhysH))
  FtCheck(Bool(Abs(FsViewX * 2 + FsViewW - PhysW) <= 1 And Abs(FsViewY * 2 + FsViewH - PhysH) <= 1), std$ + ": centred at " + StrF(FsViewX, 0) + "," + StrF(FsViewY, 0))
  FtCheck(Bool(Abs(Neon_UIScale - PhysW / Util_WinWidth) < 0.01), std$ + ": the scale measured again: " + StrF(Neon_UIScale, 3))
  FtCheck(Bool(FtRunStopWith(#VK_ESCAPE) = 0), std$ + ": Esc is not RUN/STOP in full screen")
  FtCheck(FtRunStopWith(#VK_END), std$ + ": End is RUN/STOP in full screen")
EndProcedure

Procedure FtLeft(std$)
  Protected r.RECT, hwnd.i = WindowID(Win)
  GetWindowRect_(hwnd, @r)
  FtCheck(Bool(FullScreen = 0), std$ + ": Esc left full screen")
  FtCheck(Bool(r\left = FtRect\left And r\top = FtRect\top And r\right = FtRect\right And r\bottom = FtRect\bottom),
          std$ + ": the window's rectangle is back (" + Str(r\left) + "," + Str(r\top) + " - " + Str(r\right) + "," + Str(r\bottom) + ")")
  FtCheck(Bool(GetWindowLongPtr_(hwnd, #GWL_STYLE) = FtStyle), std$ + ": the window's style is back")
  FtCheck(FtRunStopWith(#VK_ESCAPE), std$ + ": Esc is RUN/STOP in the window again")
EndProcedure

; One step, after each frame is drawn.
Procedure FtStep()
  Protected f.i, frame0.i
  If FtDone : ProcedureReturn : EndIf
  FtWait + 1
  If FtWait < 20 : ProcedureReturn : EndIf   ; frames for each step to settle
  If FtStep = 3 And ElapsedMilliseconds() - FtMs < 1000 : ProcedureReturn : EndIf   ; a second of full screen
  FtWait = 0 : FtStep + 1
  Select FtStep
    Case 1
      GetWindowRect_(WindowID(Win), @FtRect) : FtStyle = GetWindowLongPtr_(WindowID(Win), #GWL_STYLE)
      FtCheck(Bool(C64Pal = 0), "the window starts as the NTSC C64")
      FtCheck(FtRunStopWith(#VK_ESCAPE), "Esc is RUN/STOP in the window")
      FtCheck(FtRunStopWith(#VK_END), "End is RUN/STOP in the window")
      FtKey(#VK_ESCAPE)
    Case 2
      FtCheck(Bool(FullScreen = 0), "Esc in the window leaves the window as it is")
      FtKey(#VK_F11)
    Case 3
      FtFrame = C64Frame : FtMs = ElapsedMilliseconds()
    Case 4
      FtFull("NTSC")
      FtCheck(Bool(Abs((C64Frame - FtFrame) * 1000.0 / (ElapsedMilliseconds() - FtMs) - 59.83) < 6), "NTSC: the machine runs on at its own rate in full screen (" +
              StrF((C64Frame - FtFrame) * 1000.0 / (ElapsedMilliseconds() - FtMs), 1) + " frames a second, 59.83 wanted)")
      If FtShot$ : SaveWindowShot(FtShot$) : EndIf
      FtKey(#VK_ESCAPE)
    Case 5
      FtLeft("NTSC")
      WantPal = 1 : MachineStart()
    Case 6
      FtCheck(C64Pal, "switched to PAL")
      FtKey(#VK_F11)
    Case 7
      FtFull("PAL")
      FtKey(#VK_ESCAPE)
    Case 8
      FtLeft("PAL")
      FtLog$ + "fullscreen-test: " + Str(FtFails) + " failures" + #LF$
      f = CreateFile(#PB_Any, FtFile$)
      If f : WriteString(f, FtLog$) : CloseFile(f) : EndIf
      FtDone = 1 : Quit = 1
  EndSelect
EndProcedure

Procedure Tick()
  Protected now.q, dt.f, mx.i, my.i, down.b, toolH.f, x.f, gx.f, gy.f, gw.f, gh.f, scale.f, side.f
  Protected panelX.f, label$, f$
  now = ElapsedMilliseconds() : dt = (now - LastDraw) / 1000.0 : LastDraw = now
  If dt > 0.25 : dt = 0.25 : EndIf
  Emulate()
  If SoundOn : SoundPump() : EndIf
  If now - FpsSince >= 1000
    FpsShown = FpsFrames * 1000.0 / (now - FpsSince)
    If FpsFrames : EmuUsShown = EmuUsSum / FpsFrames : EndIf
    FpsFrames = 0 : EmuUsSum = 0
    IpsShown = (CpuInstructions - IpsInstr) * 1000 / (now - FpsSince) : IpsInstr = CpuInstructions
    FpsSince = now
  EndIf

  ; the pointer as Windows gives a DPI-aware window - physical pixels - passed in AS IT IS (GlUIChrome.pbi 5a)
  mx = WindowMouseX(Win) : my = WindowMouseY(Win)
  CompilerIf #PB_Compiler_OS = #PB_OS_Windows
    If GetActiveWindow() = Win : down = Bool(GetAsyncKeyState_(#VK_LBUTTON) & $8000) : EndIf
  CompilerElse
    down = Bool(GetGadgetAttribute(Gl, #PB_OpenGL_Buttons) & #PB_OpenGL_LeftButton)
  CompilerEndIf
  If PtOn : mx = PtX : my = PtY : down = PtDown : EndIf   ; --pointer-test: the synthetic point, the same path
  Neon_ChromeBeginFrame(mx, my, down, Wheel, KeyCode, KeyChar, dt)
  Wheel = 0 : KeyCode = 0 : KeyChar = 0

  ; one context on one thread: made current once (wglMakeCurrent cost ~8 ms a call on this PC)
  If GlCurrent = 0 : SetGadgetAttribute(Gl, #PB_OpenGL_SetContext, #True) : GlCurrent = 1 : EndIf
  glBindFramebuffer(#GL_FRAMEBUFFER, 0)
  glDisable_(#GL_SCISSOR_TEST)
  glViewport_(GL_ViewportX, GL_ViewportY, GL_ViewportW, GL_ViewportH)
  glClearColor_(Neon_C_BgR, Neon_C_BgG, Neon_C_BgB, 1.0)
  glClear_(#GL_COLOR_BUFFER_BIT)
  glEnable_(#GL_BLEND) : glBlendFunc_(#GL_SRC_ALPHA, #GL_ONE_MINUS_SRC_ALPHA)

  If FullScreen
    DrawFullScreen(PhysW, PhysH)
    Neon_ChromeEndFrame()
    If ShotFile$ <> "" And now >= ShotAtMs : SaveWindowShot(ShotFile$) : Quit = 1 : EndIf
    SetGadgetAttribute(Gl, #PB_OpenGL_FlipBuffers, #True)
    If FtOn : FtStep() : EndIf
    ProcedureReturn
  EndIf

  toolH = Round(Neon_S(40), #PB_Round_Nearest)
  Neon_Box(0, 0, PhysW, toolH, Neon_C_HeadR, Neon_C_HeadG, Neon_C_HeadB)
  x = Neon_S(8)
  If Btn("Open", x, Neon_S(6), Neon_S(96), toolH - Neon_S(12), "Open...") : ViewOpenDialog() : EndIf : x + Neon_S(102)
  If Btn("ROMs", x, Neon_S(6), Neon_S(64), toolH - Neon_S(12), "ROMs...")
    f$ = PathRequester("Choose the folder with the C64's BASIC, KERNAL and character ROMs", RomDir$)
    If f$ <> ""
      If FindRoms(f$) : MachineStart() : Paused = 0 : Else : StatusLine$ = "No basic / kernal / char ROM files of the right sizes in " + f$ : EndIf
    EndIf
  EndIf : x + Neon_S(70)
  label$ = "Pause" : If Paused : label$ = "Run" : EndIf
  If Btn("Pause", x, Neon_S(6), Neon_S(72), toolH - Neon_S(12), label$ + "  F5", Bool(Paused = 0)) : Paused = 1 - Paused : EmuLastUs = ElapsedMicroseconds() : EndIf : x + Neon_S(78)
  If Btn("Step", x, Neon_S(6), Neon_S(80), toolH - Neon_S(12), "Step  F6") : StepInstruction() : EndIf : x + Neon_S(86)
  If Btn("Frame", x, Neon_S(6), Neon_S(88), toolH - Neon_S(12), "Frame  F7") : StepFrame() : EndIf : x + Neon_S(94)
  If Btn("Reset", x, Neon_S(6), Neon_S(82), toolH - Neon_S(12), "Reset  F8") : MachineStart() : EndIf : x + Neon_S(88)
  label$ = "Mute" : If SoundMuted : label$ = "Sound" : EndIf
  If Btn("Mute", x, Neon_S(6), Neon_S(64), toolH - Neon_S(12), label$, SoundMuted) : SoundMuted = 1 - SoundMuted : EndIf : x + Neon_S(70)
  label$ = StringField("NTSC|PAL", 1 + WantPal, "|")
  If Btn("Standard", x, Neon_S(6), Neon_S(56), toolH - Neon_S(12), label$) : WantPal = 1 - WantPal : MachineStart() : EndIf : x + Neon_S(62)
  label$ = "Joy keys " + Str(KbJoyPort) : If KbJoyKeys = 0 : label$ = "Joy keys off" : EndIf
  If Btn("Joy keys", x, Neon_S(6), Neon_S(104), toolH - Neon_S(12), label$, KbJoyKeys)
    If KbJoyKeys = 0 : KbJoyKeys = 1 : KbJoyPort = 2 : ElseIf KbJoyPort = 2 : KbJoyPort = 1 : Else : KbJoyKeys = 0 : EndIf
  EndIf : x + Neon_S(110)
  If Btn("Full screen", x, Neon_S(6), Neon_S(124), toolH - Neon_S(12), "Full screen  F11") : WindowAction(#ACT_FULLSCREEN) : EndIf : x + Neon_S(130)
  Neon_Text(*Neon_FontMono, x + Neon_S(8), toolH / 2 - Neon_S(8), StrD(FpsShown, 1) + " fps  " + StrD(EmuUsShown / 1000.0, 2) + " ms/frame  " + Str(IpsShown / 1000) + "k instr/s   " + StatusLine$, Neon_C_DimR, Neon_C_DimG, Neon_C_DimB)

  side = Round(Neon_S(600), #PB_Round_Nearest)
  If side > PhysW * 0.55 : side = PhysW * 0.55 : EndIf
  gw = PhysW - side - Neon_S(24) : gh = PhysH - toolH - Neon_S(24)
  scale = gw / 384.0 : If gh / VicViewH < scale : scale = gh / VicViewH : EndIf
  If scale >= 1.0 : scale = Int(scale) : EndIf
  gx = Neon_S(12) + (gw - 384 * scale) / 2 : gy = toolH + Neon_S(12) + (gh - VicViewH * scale) / 2
  ViewDrawScreen(gx, gy, scale)
  If Stopped : Neon_Text(*Neon_FontBold, gx + Neon_S(8), gy + Neon_S(8), "CPU STOPPED: opcode $" + Hex2(BadOpcode) + " at $" + Hex4(PC), Neon_C_RedR, Neon_C_RedG, Neon_C_RedB) : EndIf

  panelX = PhysW - side - Neon_S(6)
  ActiveTab = Neon_TabStrip(1, panelX, toolH + Neon_S(6), side, Neon_S(30), "CPU|VIC-II|SID|CIAs|Tests|Programs|Controls", ActiveTab)
  ViewDrawPanel(ActiveTab, panelX, toolH + Neon_S(40), side, PhysH - toolH - Neon_S(46))

  Neon_ChromeEndFrame()
  If ShotFile$ <> "" And now >= ShotAtMs : SaveWindowShot(ShotFile$) : Quit = 1 : EndIf
  SetGadgetAttribute(Gl, #PB_OpenGL_FlipBuffers, #True)
  If FtOn : FtStep() : EndIf
  If PtOn
    PtStep()
    If PtDone : Quit = 1 : EndIf
  EndIf
EndProcedure

; ---------------------------------------------------------------- main
; Windows 11 slows a windowed process it judges to be in the background (EcoQoS power throttling);
; an emulator keeping real time must not be, so the process opts out of execution-speed throttling.
Prototype.i ProtoSetProcessInformation(process.i, infoClass.l, *info, size.l)
Procedure NoPowerThrottling()
  CompilerIf #PB_Compiler_OS = #PB_OS_Windows
    Protected lib.i = OpenLibrary(#PB_Any, "kernel32.dll"), Set.ProtoSetProcessInformation
    Protected Dim st.l(2)
    If lib
      Set = GetFunction(lib, "SetProcessInformation")
      ; PROCESS_POWER_THROTTLING_STATE: version 1, control EXECUTION_SPEED (1), state 0 = off
      st(0) = 1 : st(1) = 1 : st(2) = 0
      If Set : Set(GetCurrentProcess_(), 4, @st(0), 12) : EndIf
      CloseLibrary(lib)
    EndIf
  CompilerEndIf
EndProcedure

Procedure Main()
  Protected ev.i, file$, et.i, k.i, roms$
  NoPowerThrottling()
  Gl = OpenGLWindow("PureMetal C64", 1440, 860, #PB_Window_SystemMenu | #PB_Window_ScreenCentered | #PB_Window_SizeGadget | #PB_Window_MinimizeGadget | #PB_Window_MaximizeGadget)
  If Gl = 0 : MessageRequester("PureMetal C64", "OpenGL could not be started.") : End 1 : EndIf
  Win = Util_MainWindowID
  ; the engine binds Esc to a shortcut of its own; here Esc is the C64's RUN/STOP in the window and leaves full screen
  RemoveKeyboardShortcut(Win, #PB_Shortcut_Escape)
  MeasureWindow()   ; the scale, the fonts, the canvas
  GL_SetVSync(1)
  ViewInit()
  KbInit()
  SoundBegin()
  PadCount = InitJoystick()
  Prefs$ = GetPathPart(ProgramFilename()) + "PureMetalC64.prefs"
  If OpenPreferences(Prefs$) : roms$ = ReadPreferenceString("roms", "") : ViewFolder$ = ReadPreferenceString("folder", "") : ClosePreferences() : EndIf
  For k = 0 To CountProgramParameters() - 1
    Select LCase(ProgramParameter(k))
      Case "--mute" : SoundMuted = 1
      Case "--ntsc" : WantPal = 0
      Case "--pal" : WantPal = 1
      Case "--roms" : k + 1 : roms$ = ProgramParameter(k)
      Case "--tab" : k + 1 : ActiveTab = Val(ProgramParameter(k))
      Case "--fullscreen-test" : k + 1 : FtFile$ = ProgramParameter(k) : FtOn = 1
        If k + 1 < CountProgramParameters() And Left(ProgramParameter(k + 1), 2) <> "--" : k + 1 : FtShot$ = ProgramParameter(k) : EndIf
      Case "--pointer-test" : k + 1 : PtFile$ = ProgramParameter(k) : PtOn = 1
      Case "--shot" : k + 1 : ShotFile$ = ProgramParameter(k) : If ShotAtMs = 0 : ShotAtMs = 5000 : EndIf
      Case "--seconds" : k + 1 : ShotAtMs = Val(ProgramParameter(k)) * 1000
      Default : file$ = ProgramParameter(k)
    EndSelect
  Next
  If roms$ = "" : roms$ = GetPathPart(ProgramFilename()) + "roms\" : EndIf
  FindRoms(roms$)
  ViewFilesRefresh(ViewFolder$)
  If file$ <> "" : OpenProgram(file$) : Else : MachineStart() : EndIf
  If PtOn : SoundMuted = 1 : PtInit() : EndIf
  If FtOn : SoundMuted = 1 : EndIf
  FpsSince = ElapsedMilliseconds() : LastDraw = FpsSince
  If ShotFile$ <> "" : ShotAtMs + FpsSince : EndIf
  Repeat
    Repeat
      ev = WindowEvent()
      Select ev
        Case #PB_Event_CloseWindow : Quit = 1
        Case #PB_Event_SizeWindow, #PB_Event_MaximizeWindow, #PB_Event_RestoreWindow, #PB_Event_MoveWindow : MeasureWindow()
        Case #PB_Event_Gadget
          If EventGadget() = Gl
            et = EventType()
            Select et
              Case #PB_EventType_KeyDown
                k = GetGadgetAttribute(Gl, #PB_OpenGL_Key) : KeyCode = k
                WindowAction(ControlsAction(k, FullScreen))
              Case #PB_EventType_Input : KeyChar = GetGadgetAttribute(Gl, #PB_OpenGL_Input)
              Case #PB_EventType_MouseWheel : Wheel + GetGadgetAttribute(Gl, #PB_OpenGL_WheelDelta)
            EndSelect
          EndIf
      EndSelect
    Until ev = 0 Or Quit
    If Quit : Break : EndIf
    Tick()
  Until Quit
  SoundEnd()
  If PtOn : End PtFails : EndIf
  If FtOn : End FtFails : EndIf   ; --pointer-test: the number of failures
EndProcedure
Main()

DataSection
TextLoadRun:
  Data.a 76, 79, 65, 68, 34, 42, 34, 44, 56, 44, 49, 13, 82, 85, 78, 13, 0
EndDataSection
